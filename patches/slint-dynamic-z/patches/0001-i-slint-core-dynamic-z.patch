+/// Visit the children of `item_rc` in hit-testing order: children with a
+/// higher (possibly dynamic) `z` value first, then children with equal `z` in
+/// their original FrontToBack (tree) order. This keeps mouse hit-testing
+/// consistent with the z-sorted paint order.
+fn visit_children_sorted_by_z(
+    item_rc: &ItemRc,
+    mut visitor: impl FnMut(&ItemTreeRc, u32, Pin<ItemRef>) -> VisitChildrenResult,
+) -> VisitChildrenResult {
+    let mut children: Vec<(f32, u32, crate::item_tree::ItemTreeRc)> = Vec::new();
+    let mut collect_visitor =
+        |component: &crate::item_tree::ItemTreeRc, index: u32, item: Pin<ItemRef>| -> VisitChildrenResult {
+            children.push((item.as_ref().z(), index, component.clone()));
+            VisitChildrenResult::CONTINUE
+        };
+    vtable::new_vref!(let mut collect_visitor : VRefMut<crate::item_tree::ItemVisitorVTable> for crate::item_tree::ItemVisitor = &mut collect_visitor);
+    vtable::VRc::borrow_pin(item_rc.item_tree()).as_ref().visit_children_item(
+        item_rc.index() as isize,
+        crate::item_tree::TraversalOrder::FrontToBack,
+        collect_visitor,
+    );
+
+    // Stable sort descending by z: the visually topmost child is hit-tested first.
+    children.sort_by(|(a, _, _), (b, _, _)| b.partial_cmp(a).unwrap_or(core::cmp::Ordering::Equal));
+
+    for (_, index, component) in children {
+        let child = ItemRc::new(component.clone(), index);
+        let borrowed = child.borrow();
+        let r = visitor(&component, index, borrowed);
+        if r.has_aborted() {
+            return r;
+        }
+    }
+    VisitChildrenResult::CONTINUE
+}
