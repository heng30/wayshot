export enum Fps {
    Fps24,
    Fps25,
    Fps30,
    Fps60,
}

export enum Resolution {
    Original,
    P480,
    P720,
    P1080,
    P2K,
    P4K,
    Portrait480P,    // 480x854 (9:16)
    Portrait720P,    // 720x1280 (9:16)
    Portrait1080P,   // 1080x1920 (9:16)
    Portrait4K,      // 2160x3840 (9:16)
    Square480P,      // 480x480 (1:1)
    Square720P,      // 720x720 (1:1)
    Square1080P,     // 1080x1080 (1:1)
    InstagramPortrait, // 1080x1350 (4:5)
}

export enum AudioFormat {
    Aac,
    Mp3,
    Ogg,
    Wav,
    Flac,
}

export enum AudioChannels {
    Mono,
    Stereo,
}

export enum AudioSampleRate {
    Hz8000,
    Hz16000,
    Hz24000,
    Hz32000,
    Hz44100,
    Hz48000,
    Hz96000,
    Hz192000,
}

