export struct VideoEditorUIState {
    id: string,
    tracks-height: string,
    left-panel-width: string,
    right-panel-width: string,
    tracks-zoom-level: string,
    preview-volume: float,

    // 是否联动轨道内的segment，如果为true，则需要调整受影响的segment时间轴
    enabled-link-track: bool,

    // 是否联动所有轨道，如果为true，则需要调整受影响的所有轨道的segment时间轴
    enabled-link-all-tracks: bool,

    // 预览窗口网格大小：0 表示关闭，其他值如 3 表示 3x3 网格
    preview-grid-size: int,

    // 播放列表和媒体库的视图模式：0 = 列表模式, 1 = 缩略图模式
    playlist-view-mode: int,
    library-view-mode: int,
}

export enum VideoEditorTrackType {
    Video,
    Audio,
    Subtitle,
    Image,
    Text,
}


export struct VideoEditorSubtitleSearchEntry {
    start-time: string, // 显示用，如 00:01:23,500
    end-time: string,   // 显示用，如 00:01:26,000
    text: string,
    start-ms: int,      // 用于跳转
}

export struct VideoEditorTrackSegment {
    uuid: string,
    hiding: bool,
    audio-muted: bool,
    filename: string,
    duration: int,          // ms - timeline 显示时长（受 playback_speed 影响）
    original-duration: int, // ms - 源内容原始时长（不受 playback_speed 影响）
    timeline-offset: int,   // ms
    source-offset: int,     // ms - 源文件中的起始位置
    source-duration: int,   // ms - 源文件的总时长，用于限制右边沿拉伸
    playback-speed: float,  // 播放速度倍率 (默认 1.0, 范围 0.1-10.0)
    subtitle-text: string,
    overlay-text: string,
    left-thumbnail: image,
    right-thumbnail: image,
    preview-audio-channels: int,
    preview-audio-samples: [float], // 只用于预览，可能经过重采样和平均化
    preview-audio-amplitude-scale: float,
    filters: [SegmentFilter], // 每个segment拥有的滤镜
}

export struct VideoEditorTrack {
    locked: bool,
