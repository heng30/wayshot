    duplicate-dir-name: string,
    all-files: bool,
}

export struct VideoEditorDedupPhotosItem {
    path: string,
    filename: string,
    status: int,
    error-msg: string,
    result-msg: string,
}

export struct VideoEditorSimilarVideoSegmentItem {
    path: string,
    filename: string,
    status: int,
    error-msg: string,
    match-count: int,
}

export enum MusicGenModel {
    Small,
    SmallFp16,
    SmallQuant,
    Medium,
    MediumFp16,
    MediumQuant,
    Large,
}

export struct VideoEditorMusicGenConfig {
    id: string,
    selected-model-index: int,
    export-dir: string,
    small-model-dir: string,
    small-fp16-model-dir: string,
    small-quant-model-dir: string,
    medium-model-dir: string,
    medium-fp16-model-dir: string,
    medium-quant-model-dir: string,
    large-model-dir: string,
    duration: int,
    prompt: string,
}

export struct VideoEditorSpeakersConfig {
    id: string,
    export-dir: string,
    models-dir: string,
    merge-gap: float,
    timeline-mode: bool,
}


export struct OcrTextBlock {
    text: string,
    x1: int,
    y1: int,
    x2: int,
    y2: int,
}

export enum OcrTaskMode {
    Text,
    Spotting,
}

export struct VideoEditorOCRConfig {
    id: string,
    model-dir: string,
    task-mode: OcrTaskMode,
    timeout: int,
}

export struct AudioPlayerStatus {
    name: string,
    sound: float,
    progress: float,
    duration-ms: int,
    is-playing: bool,
    is-processing: bool,
}


export enum SceneDetectorAlgorithm {
    Content,
    Adaptive,
    Histogram,
    Threshold,
}

export struct SceneDetectConfig {
    algorithm: SceneDetectorAlgorithm,
    min-duration: int,
    content-threshold: float,
    adaptive-threshold: float,
    histogram-threshold: float,
    threshold-threshold: float,
}

export enum ChapterSummaryProgressType {
    None,
    Generating,
    Finished,
    Failed,
    Cancelled,
}

export struct ChapterSummaryEntry {
    start-ms: int,
    end-ms: int,
    title: string,
}

export struct VideoEditorBookmarkEntry {
    time-ms: int,
}

export enum SubtitleTranslateProgressType {
    None,
    Translating,
    Finished,
    Failed,
    Cancelled,
}

export struct SubtitleTranslateConfig {
    id: string,
    prompt: string,
    batch-size: int,
    max-retries: int,
}

//////////////////////////////// Logic Struct End  ////////////////////////////////

export global Store {
    function startup-tab-to-tab-index(tab: StartupTab) -> TabIndex {
        if (tab == StartupTab.VideoEditor) {
            return TabIndex.VideoEditor;
        } else if (tab == StartupTab.Transcribe) {
            return TabIndex.Transcribe;
        } else if (tab == StartupTab.ShareScreen) {
            return TabIndex.ShareScreen;
        } else {
            return TabIndex.Home;
        }
    }

    in-out property <DeviceType> device-type: DeviceType.Desktop;
    in-out property <bool> is-first-run;
    in-out property <bool> is-show-landing-page;
    in-out property <bool> is-show-help-btn;
    in-out property <bool> is-show-remove-caches-btn;

    in-out property <TabIndex> previous-tab-index: TabIndex.Home;
    in-out property <TabIndex> current-tab-index: startup-tab-to-tab-index(setting-preference.startup-tab);
    in-out property <PopupIndex> current-popup-index: PopupIndex.None;
    in-out property <SettingDetailIndex> current-setting-detail-index: SettingDetailIndex.Preference;

    in-out property <SettingPreference> setting-preference: {
        win-width: 700,
        win-height: 640,
        font-size: "16",
        font-family: "Source Han Sans CN",
        language: "en",
        always-on-top: false,
        no-frame: true,
        is-dark: true,
        startup-tab: StartupTab.VideoEditor,
    };

    //////////////////////////////// Logic Start ////////////////////////////////
    in-out property <bool> is-cn: setting-preference.language == "cn";
    in-out property <RecordStatus> record-status: RecordStatus.Stopped;
    in-out property <FeatureType> feature-type: FeatureType.Other;
    in-out property <ProcessMode> process-mode: ProcessMode.RecordScreen;
    in-out property <string> save-dir;
    in-out property <bool> never-recording-once: true;

    in-out property <int> record-duration;
    in-out property <string> final-video-path;
    in-out property <image> preview-image;
    in-out property <int> audio-db: -60;
    in-out property <int> speaker-audio-db: -60;
    in-out property <bool> start-recording-timer;

    in-out property <[Source]> sources: [];
    in-out property <[string]> audio-sources: [];
    in-out property <[string]> video-sources: [];
    in-out property <[string]> camera-sources: [];
    in-out property <StatsInfo> stats-info;

    in-out property <SettingControl> setting-control:  {
        screen: sources[1].name,
        audio: sources[0].name,
        audio-gain: -2,
        enable-audio: true,
        speaker-gain: 2,
        enable-speaker: true,
        camera: sources[2].name,
        enable-camera: true,
        camera-setting: {
            border-size: 3,
            is-circle-shape: false,
            rect-cropping-width: 150,
            rect-cropping-height: 150,
            circle-cropping-radius: 150,
            cropping-x: 0.5,
            cropping-y: 0.5,
        }
    };

    in-out property <string> latest-version;
    in-out property <string> update-content;
    in-out property <bool> is-show-update-dialog;

    in-out property <bool> is-show-realtime-image-effect-dialog;
