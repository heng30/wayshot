    // 拖拽预览状态: 拖拽时只更新UI，释放时才提交到后台
    in-out property <bool> video-editor-segment-is-dragging;
    in-out property <string> video-editor-drag-segment-uuid;
    in-out property <int> video-editor-drag-preview-offset;   // ms
    in-out property <int> video-editor-drag-preview-duration; // ms
    // 联动预览: 记录拖拽的segment位置，用于后续segment联动
    in-out property <int> video-editor-drag-segment-track-index: -1;
    in-out property <int> video-editor-drag-segment-index: -1;
    in-out property <int> video-editor-drag-delta-ms; // 拖拽偏移量（相对于原始位置）
    in-out property <bool> video-editor-drag-is-move; // 标记当前拖拽是否为移动操作（非resize）
    // 联动所有轨道时的最小timeline-offset，用于限制向左移动
    in-out property <int> video-editor-drag-min-all-tracks-offset;
    // 拖拽开始时 segment 的原始时间范围，用于跨轨道重叠检测
    in-out property <int> video-editor-drag-original-offset;
    in-out property <int> video-editor-drag-original-duration;

    // 跨轨道 segment 拖拽状态，可以自由放置segment位置（包含在原本轨道移动segment）
    in-out property <bool> video-editor-segment-cross-track-dragging;  // 是否正在跨轨道拖拽
    in-out property <int> video-editor-segment-cross-track-target-index: -1;  // 目标轨道索引
    in-out property <int> video-editor-segment-cross-track-timeline-offset-ms;  // 目标位置时间偏移
    in-out property <bool> video-editor-segment-cross-track-will-split;  // 是否会分割目标segment
    in-out property <int> video-editor-segment-cross-track-split-segment-index: -1;  // 将被分割的segment索引

    // 播放列表和媒体库预览设置
    in-out property <bool> video-editor-is-show-item-preview-dialog;
