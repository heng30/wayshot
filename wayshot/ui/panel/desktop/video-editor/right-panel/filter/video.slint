export component FilterVideoDetail inherits Rectangle {
    in-out property <int> index: -1;
    in-out property <SegmentFilter> selected-filter;

    border-radius: Theme.border-radius;

    if selected-filter.name.to-lowercase() == "flip": Flip {
        index: index;
        width: parent.width;
        selected-filter: selected-filter;

        apply(idx, config) => {
            VEFilter.modify-flip-filter(idx, config, FilterType.Video);
        }
    }

    if selected-filter.name.to-lowercase() == "chroma key": ChromaKey {
        index: index;
        width: parent.width;
