import {
    Theme,
    Logic,
    Icons,
    Util,
    Store,
    KeyframeValueType,
    KeyframeValue,
} from "../../../../../def.slint";
import {
    ClickAndEditLabel,
    LineInput,
    Slider,
    Select,
    SettingDetailInner,
    SettingDetailInnerVbox,
    SettingDetailLabel,
} from "../../../../../../base/widgets.slint";
import {
    VEFilter,
    SegmentFilter,
    LightingDetail,
} from "../../../filter.slint";
import { KeyframeButton } from "../keyframe-btn.slint";

export component Lighting inherits Rectangle {
    in-out property <int> index: -1;
    in-out property <SegmentFilter> selected-filter;
    in-out property <LightingDetail> config: VEFilter.from-lighting-json(selected-filter.detail);
    in-out property toggle-keyframe-flag <=> VEFilter.toggle-keyframe-flag;

    callback apply(index: int, config: LightingDetail);

    changed selected-filter => {
        if (selected-filter.name == "lighting") {
            self.config = VEFilter.from-lighting-json(selected-filter.detail);
            brightness-sl.value = self.config.brightness;
            angle-deg-sl.value = self.config.angle-deg;
            penumbra-sl.value = self.config.penumbra;
            decay-sl.value = self.config.decay;
            max-distance-sl.value = self.config.max-distance;
            pos-x-sl.value = self.config.pos-x;
            pos-y-sl.value = self.config.pos-y;
            ambient-sl.value = self.config.ambient;
            swing-sl.value = self.config.swing;
            rope-length-sl.value = self.config.rope-length;
        }
    }

    in-out property <bool> color-picker-confirmed-flag: Store.video-editor-color-picker-confirmed-flag;
    private property <int> video-editor-color-picker-id;

    changed color-picker-confirmed-flag => {
        if (video-editor-color-picker-id != Store.video-editor-color-picker-id) {
            return;
        }
        let c = Store.video-editor-color-picker-color;
        config.color-r = c.red;
        config.color-g = c.green;
        config.color-b = c.blue;
        apply(index, config);
    }

    SettingDetailInner {
        interactive: false;

        // Position X (-1-2, keyframed)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Position X");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                HorizontalLayout {
                    spacing: Theme.spacing * 4;

                    VerticalLayout {
                        alignment: center;

                        pos-x-sl := Slider {
                            minimum: -1.0;
                            maximum: 2.0;
                            value: config.pos-x;
                            indicator-size: Theme.default-font-size;
                            height: self.indicator-size * 0.3;
                            unfinished-progress-color: Theme.thirdly-background;
                            enabled: selected-filter.enabled;

                            changed(value) => {
                                config.pos-x = value;
                            }

                            released(value) => {
                                config.pos-x = value;
                                apply(index, config);
                            }
                        }
                    }

                    ClickAndEditLabel {
                        enabled: selected-filter.enabled;
                        use-fixed-width: true;
                        width: Theme.default-font-size * 3;
                        text: config.pos-x.to-fixed(2);
                        text-color: self.enabled ? Theme.primary-text-color : Theme.disabled-color;

                        accepted(text) => {
                            config.pos-x = text.to-float().clamp(-1, 2);
                            pos-x-sl.value = config.pos-x;
                            apply(index, config);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    KeyframeButton {
                        enabled: selected-filter.enabled;
                        has-keyframe: VEFilter.property-has-keyframe-at-playhead(index, "pos", toggle-keyframe-flag);

                        clicked => {
                            VEFilter.toggle-keyframe-at-playhead(index, "pos", VEFilter.make-float2-value(config.pos-x, config.pos-y));
                            toggle-keyframe-flag = !toggle-keyframe-flag;
                        }
                    }
                }
            }
        }

        // Position Y (-1-2, keyframed)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Position Y");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                HorizontalLayout {
                    spacing: Theme.spacing * 4;

                    VerticalLayout {
                        alignment: center;

                        pos-y-sl := Slider {
                            minimum: -1.0;
                            maximum: 2.0;
                            value: config.pos-y;
                            indicator-size: Theme.default-font-size;
                            height: self.indicator-size * 0.3;
                            unfinished-progress-color: Theme.thirdly-background;
                            enabled: selected-filter.enabled;

                            changed(value) => {
                                config.pos-y = value;
                            }

                            released(value) => {
                                config.pos-y = value;
                                apply(index, config);
                            }
                        }
                    }

                    ClickAndEditLabel {
                        enabled: selected-filter.enabled;
                        use-fixed-width: true;
                        width: Theme.default-font-size * 3;
                        text: config.pos-y.to-fixed(2);
                        text-color: self.enabled ? Theme.primary-text-color : Theme.disabled-color;

                        accepted(text) => {
                            config.pos-y = text.to-float().clamp(-1, 2);
                            pos-y-sl.value = config.pos-y;
                            apply(index, config);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    KeyframeButton {
                        enabled: selected-filter.enabled;
                        has-keyframe: VEFilter.property-has-keyframe-at-playhead(index, "pos", toggle-keyframe-flag);

                        clicked => {
                            VEFilter.toggle-keyframe-at-playhead(index, "pos", VEFilter.make-float2-value(config.pos-x, config.pos-y));
                            toggle-keyframe-flag = !toggle-keyframe-flag;
                        }
                    }
                }
            }
        }

        // Swing (0-1, keyframed)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Swing");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                HorizontalLayout {
                    spacing: Theme.spacing * 4;

                    VerticalLayout {
                        alignment: center;

                        swing-sl := Slider {
                            minimum: 0.0;
                            maximum: 1.0;
                            value: config.swing;
                            indicator-size: Theme.default-font-size;
                            height: self.indicator-size * 0.3;
                            unfinished-progress-color: Theme.thirdly-background;
                            enabled: selected-filter.enabled;

                            changed(value) => {
                                config.swing = value;
                            }

                            released(value) => {
                                config.swing = value;
                                apply(index, config);
                            }
                        }
                    }

                    ClickAndEditLabel {
                        enabled: selected-filter.enabled;
                        use-fixed-width: true;
                        width: Theme.default-font-size * 3;
                        text: config.swing.to-fixed(2);
                        text-color: self.enabled ? Theme.primary-text-color : Theme.disabled-color;

                        accepted(text) => {
                            config.swing = text.to-float().clamp(0, 1);
                            swing-sl.value = config.swing;
                            apply(index, config);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    KeyframeButton {
                        enabled: selected-filter.enabled;
                        has-keyframe: VEFilter.property-has-keyframe-at-playhead(index, "swing", toggle-keyframe-flag);

                        clicked => {
                            VEFilter.toggle-keyframe-at-playhead(index, "swing", VEFilter.make-float-value(config.swing));
                            toggle-keyframe-flag = !toggle-keyframe-flag;
                        }
                    }
                }
            }
        }

        // Rope Length (0-1, keyframed)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Rope Length");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                HorizontalLayout {
                    spacing: Theme.spacing * 4;

                    VerticalLayout {
                        alignment: center;

                        rope-length-sl := Slider {
                            minimum: 0.0;
                            maximum: 1.0;
                            value: config.rope-length;
                            indicator-size: Theme.default-font-size;
                            height: self.indicator-size * 0.3;
                            unfinished-progress-color: Theme.thirdly-background;
                            enabled: selected-filter.enabled;

                            changed(value) => {
                                config.rope-length = value;
                            }

                            released(value) => {
                                config.rope-length = value;
                                apply(index, config);
                            }
                        }
                    }

                    ClickAndEditLabel {
                        enabled: selected-filter.enabled;
                        use-fixed-width: true;
                        width: Theme.default-font-size * 3;
                        text: config.rope-length.to-fixed(2);
                        text-color: self.enabled ? Theme.primary-text-color : Theme.disabled-color;

                        accepted(text) => {
                            config.rope-length = text.to-float().clamp(0, 1);
                            rope-length-sl.value = config.rope-length;
                            apply(index, config);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    KeyframeButton {
                        enabled: selected-filter.enabled;
                        has-keyframe: VEFilter.property-has-keyframe-at-playhead(index, "rope_length", toggle-keyframe-flag);

                        clicked => {
                            VEFilter.toggle-keyframe-at-playhead(index, "rope_length", VEFilter.make-float-value(config.rope-length));
                            toggle-keyframe-flag = !toggle-keyframe-flag;
                        }
                    }
                }
            }
        }

        // Ambient (0-1, keyframed)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Ambient");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                HorizontalLayout {
                    spacing: Theme.spacing * 4;

                    VerticalLayout {
                        alignment: center;

                        ambient-sl := Slider {
                            minimum: 0.0;
                            maximum: 1.0;
                            value: config.ambient;
                            indicator-size: Theme.default-font-size;
                            height: self.indicator-size * 0.3;
                            unfinished-progress-color: Theme.thirdly-background;
                            enabled: selected-filter.enabled;

                            changed(value) => {
                                config.ambient = value;
                            }

                            released(value) => {
                                config.ambient = value;
                                apply(index, config);
                            }
                        }
                    }

                    ClickAndEditLabel {
                        enabled: selected-filter.enabled;
                        use-fixed-width: true;
                        width: Theme.default-font-size * 3;
                        text: config.ambient.to-fixed(2);
                        text-color: self.enabled ? Theme.primary-text-color : Theme.disabled-color;

                        accepted(text) => {
                            config.ambient = text.to-float().clamp(0, 1);
                            ambient-sl.value = config.ambient;
                            apply(index, config);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    KeyframeButton {
                        enabled: selected-filter.enabled;
                        has-keyframe: VEFilter.property-has-keyframe-at-playhead(index, "ambient", toggle-keyframe-flag);

                        clicked => {
                            VEFilter.toggle-keyframe-at-playhead(index, "ambient", VEFilter.make-float-value(config.ambient));
                            toggle-keyframe-flag = !toggle-keyframe-flag;
                        }
                    }
                }
            }
        }

        // Brightness (0-5000, keyframed)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Brightness");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                HorizontalLayout {
                    spacing: Theme.spacing * 4;

                    VerticalLayout {
                        alignment: center;

                        brightness-sl := Slider {
                            minimum: 0.0;
                            maximum: 5000.0;
                            value: config.brightness;
                            indicator-size: Theme.default-font-size;
                            height: self.indicator-size * 0.3;
                            unfinished-progress-color: Theme.thirdly-background;
                            enabled: selected-filter.enabled;

                            changed(value) => {
                                config.brightness = value;
                            }

                            released(value) => {
                                config.brightness = value;
                                apply(index, config);
                            }
                        }
                    }

                    ClickAndEditLabel {
                        enabled: selected-filter.enabled;
                        use-fixed-width: true;
                        width: Theme.default-font-size * 3;
                        text: round(config.brightness);
                        text-color: self.enabled ? Theme.primary-text-color : Theme.disabled-color;

                        accepted(text) => {
                            config.brightness = text.to-float().clamp(0, 5000);
                            brightness-sl.value = config.brightness;
                            apply(index, config);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    KeyframeButton {
                        enabled: selected-filter.enabled;
                        has-keyframe: VEFilter.property-has-keyframe-at-playhead(index, "brightness", toggle-keyframe-flag);

                        clicked => {
                            VEFilter.toggle-keyframe-at-playhead(index, "brightness", VEFilter.make-float-value(config.brightness));
                            toggle-keyframe-flag = !toggle-keyframe-flag;
                        }
                    }
                }
            }
        }

        // Cone Angle (1-180, keyframed)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Cone Angle");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                HorizontalLayout {
                    spacing: Theme.spacing * 4;

                    VerticalLayout {
                        alignment: center;

                        angle-deg-sl := Slider {
                            minimum: 1.0;
                            maximum: 180.0;
                            value: config.angle-deg;
                            indicator-size: Theme.default-font-size;
                            height: self.indicator-size * 0.3;
                            unfinished-progress-color: Theme.thirdly-background;
                            enabled: selected-filter.enabled;

                            changed(value) => {
                                config.angle-deg = value;
                            }

                            released(value) => {
                                config.angle-deg = value;
                                apply(index, config);
                            }
                        }
                    }

                    ClickAndEditLabel {
                        enabled: selected-filter.enabled;
                        use-fixed-width: true;
                        width: Theme.default-font-size * 3;
                        text: round(config.angle-deg);
                        text-color: self.enabled ? Theme.primary-text-color : Theme.disabled-color;

                        accepted(text) => {
                            config.angle-deg = text.to-float().clamp(1, 180);
                            angle-deg-sl.value = config.angle-deg;
                            apply(index, config);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    KeyframeButton {
                        enabled: selected-filter.enabled;
                        has-keyframe: VEFilter.property-has-keyframe-at-playhead(index, "angle_deg", toggle-keyframe-flag);

                        clicked => {
                            VEFilter.toggle-keyframe-at-playhead(index, "angle_deg", VEFilter.make-float-value(config.angle-deg));
                            toggle-keyframe-flag = !toggle-keyframe-flag;
                        }
                    }
                }
            }
        }

        // Penumbra (0-1, keyframed)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Penumbra");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                HorizontalLayout {
                    spacing: Theme.spacing * 4;

                    VerticalLayout {
                        alignment: center;

                        penumbra-sl := Slider {
                            minimum: 0.0;
                            maximum: 1.0;
                            value: config.penumbra;
                            indicator-size: Theme.default-font-size;
                            height: self.indicator-size * 0.3;
                            unfinished-progress-color: Theme.thirdly-background;
                            enabled: selected-filter.enabled;

                            changed(value) => {
                                config.penumbra = value;
                            }

                            released(value) => {
                                config.penumbra = value;
                                apply(index, config);
                            }
                        }
                    }

                    ClickAndEditLabel {
                        enabled: selected-filter.enabled;
                        use-fixed-width: true;
                        width: Theme.default-font-size * 3;
                        text: config.penumbra.to-fixed(2);
                        text-color: self.enabled ? Theme.primary-text-color : Theme.disabled-color;

                        accepted(text) => {
                            config.penumbra = text.to-float().clamp(0, 1);
                            penumbra-sl.value = config.penumbra;
                            apply(index, config);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    KeyframeButton {
                        enabled: selected-filter.enabled;
                        has-keyframe: VEFilter.property-has-keyframe-at-playhead(index, "penumbra", toggle-keyframe-flag);

                        clicked => {
                            VEFilter.toggle-keyframe-at-playhead(index, "penumbra", VEFilter.make-float-value(config.penumbra));
                            toggle-keyframe-flag = !toggle-keyframe-flag;
                        }
                    }
                }
            }
        }

        // Decay (0-10, keyframed)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Decay");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                HorizontalLayout {
                    spacing: Theme.spacing * 4;

                    VerticalLayout {
                        alignment: center;

                        decay-sl := Slider {
                            minimum: 0.0;
                            maximum: 10.0;
                            value: config.decay;
                            indicator-size: Theme.default-font-size;
                            height: self.indicator-size * 0.3;
                            unfinished-progress-color: Theme.thirdly-background;
                            enabled: selected-filter.enabled;

                            changed(value) => {
                                config.decay = value;
                            }

                            released(value) => {
                                config.decay = value;
                                apply(index, config);
                            }
                        }
                    }

                    ClickAndEditLabel {
                        enabled: selected-filter.enabled;
                        use-fixed-width: true;
                        width: Theme.default-font-size * 3;
                        text: config.decay.to-fixed(1);
                        text-color: self.enabled ? Theme.primary-text-color : Theme.disabled-color;

                        accepted(text) => {
                            config.decay = text.to-float().clamp(0, 10);
                            decay-sl.value = config.decay;
                            apply(index, config);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    KeyframeButton {
                        enabled: selected-filter.enabled;
                        has-keyframe: VEFilter.property-has-keyframe-at-playhead(index, "decay", toggle-keyframe-flag);

                        clicked => {
                            VEFilter.toggle-keyframe-at-playhead(index, "decay", VEFilter.make-float-value(config.decay));
                            toggle-keyframe-flag = !toggle-keyframe-flag;
                        }
                    }
                }
            }
        }

        // Max Distance (1-100, keyframed)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Max Distance");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                HorizontalLayout {
                    spacing: Theme.spacing * 4;

                    VerticalLayout {
                        alignment: center;

                        max-distance-sl := Slider {
                            minimum: 1.0;
                            maximum: 100.0;
                            value: config.max-distance;
                            indicator-size: Theme.default-font-size;
                            height: self.indicator-size * 0.3;
                            unfinished-progress-color: Theme.thirdly-background;
                            enabled: selected-filter.enabled;

                            changed(value) => {
                                config.max-distance = value;
                            }

                            released(value) => {
                                config.max-distance = value;
                                apply(index, config);
                            }
                        }
                    }

                    ClickAndEditLabel {
                        enabled: selected-filter.enabled;
                        use-fixed-width: true;
                        width: Theme.default-font-size * 3;
                        text: round(config.max-distance);
                        text-color: self.enabled ? Theme.primary-text-color : Theme.disabled-color;

                        accepted(text) => {
                            config.max-distance = text.to-float().clamp(1, 100);
                            max-distance-sl.value = config.max-distance;
                            apply(index, config);
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;

                    KeyframeButton {
                        enabled: selected-filter.enabled;
                        has-keyframe: VEFilter.property-has-keyframe-at-playhead(index, "max_distance", toggle-keyframe-flag);

                        clicked => {
                            VEFilter.toggle-keyframe-at-playhead(index, "max_distance", VEFilter.make-float-value(config.max-distance));
                            toggle-keyframe-flag = !toggle-keyframe-flag;
                        }
                    }
                }
            }
        }

        // Direction (enum)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Direction");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                direction-select := Select {
                    enabled: selected-filter.enabled;
                    gain-focus-when-clicked: false;
                    background: Theme.thirdly-background;
                    values: [Logic.tr("Down"), Logic.tr("Up"), Logic.tr("Left"), Logic.tr("Right")];
                    current-index: config.direction;
                    current-value: self.values[config.direction];

                    selected(idx, value) => {
                        config.direction = idx;
                        apply(index, config);
                    }
                }
            }
        }

        // Scene (enum)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Scene");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                scene-select := Select {
                    enabled: selected-filter.enabled;
                    gain-focus-when-clicked: false;
                    background: Theme.thirdly-background;
                    values: [Logic.tr("Vertical (Wall)"), Logic.tr("Horizontal (Floor)")];
                    current-index: config.scene;
                    current-value: self.values[config.scene];

                    selected(idx, value) => {
                        config.scene = idx;
                        apply(index, config);
                    }
                }
            }
        }

        // Gravity (no range, LineInput)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Gravity");
                enabled: selected-filter.enabled;
            }

            gravity-li := LineInput {
                input-type: decimal;
                enabled: selected-filter.enabled;
                text: config.gravity;
                border-color: self.text.to-float() == config.gravity ? self.default-border-color : Theme.danger-color;

                accepted => {
                    config.gravity = self.text.to-float().max(0.0);
                    self.text = config.gravity;
                    apply(index, config);
                }
            }
        }

        // Damping (no range, LineInput)
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Damping");
                enabled: selected-filter.enabled;
            }

            damping-li := LineInput {
                input-type: decimal;
                enabled: selected-filter.enabled;
                text: config.damping;
                border-color: self.text.to-float() == config.damping ? self.default-border-color : Theme.danger-color;

                accepted => {
                    config.damping = self.text.to-float().clamp(0.9, 1.0);
                    self.text = config.damping;
                    apply(index, config);
                }
            }
        }

        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Color");
                enabled: selected-filter.enabled;
            }

            HorizontalLayout {
                spacing: Theme.spacing * 2;

                LineInput {
                    read-only: true;
                    is-show-icon: true;
                    enabled: selected-filter.enabled;
                    text: Util.color-picker-str(config.color-r, config.color-g, config.color-b, 255);
                    is-show-color-block: true;
                    color-block-color: Util.color-picker-hex-color(self.text);
                    icon: Icons.color-picker-light;
                    border-color: Theme.is-dark ? Theme.base-border-color.brighter(20%) : Theme.base-border-color.darker(10%);
                    border-width: 1px;

                    changed has-focus => {
                        if (!self.has-focus) {
                            Store.video-editor-focus-flag = !Store.video-editor-focus-flag;
                        }
                    }

                    clicked => {
                        Store.video-editor-color-picker-id = Store.video-editor-color-picker-id + 1;
                        root.video-editor-color-picker-id = Store.video-editor-color-picker-id;
                        Store.video-editor-color-picker-color = Util.color-picker-hex-color(self.text);
                        Store.video-editor-color-picker-toggle-flag = !Store.video-editor-color-picker-toggle-flag;
                    }
                }
            }
        }

        VerticalLayout { }
    }
}
