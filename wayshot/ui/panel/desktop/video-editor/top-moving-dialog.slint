export component TopMovingDialog inherits Rectangle {
    callback app-focus();

    if Store.video-editor-is-show-tts-dialog: TTSDialog {
        init => {
            self.head-x = ((root.width - self.header-width) / 2).max(0);
        }
        close => {
            Logic.video-editor-tts-release-resource();
            Store.video-editor-is-show-tts-dialog = false;
            Store.video-editor-is-show-tts-add-dialog = false;
            Store.video-editor-is-show-tts-setting-dialog = false;
            app-focus();
        }
        minimal => {
            Store.video-editor-is-show-tts-add-dialog = false;
            Store.video-editor-is-show-tts-setting-dialog = false;
            app-focus();
        }
        maximal => {
            app-focus();
        }
    }

    if Store.video-editor-is-show-tts-setting-dialog: TTSSettingDialog {
        init => {
            self.head-x = ((root.width - self.header-width) / 2).max(0);
