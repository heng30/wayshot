        }
        close => {
            Store.video-editor-is-show-item-preview-dialog = false;
            Logic.video-editor-item-preview-stop();
            Store.video-editor-item-preview-progress = 0;
            Store.video-editor-item-preview-end-time = "";
            Store.video-editor-item-preview-current-time = "";
            Store.video-editor-item-preview-is-playing = false;
            Store.video-editor-item-preview-image = @image-url("");
            Store.video-editor-item-preview-subtitle-entries = [];
            app-focus();
        }
        minimal => {
            app-focus();
        }
        maximal => {
            app-focus();
        }
    }

