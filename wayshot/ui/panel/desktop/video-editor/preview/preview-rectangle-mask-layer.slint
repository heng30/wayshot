import {
    Theme,
    Store,
    Logic,
    Util,
    Icons,
    VideoPreviewSize,
    VideoEditorLayerImage,
    RectangleMaskDetail,
} from "../../../def.slint";
import { VEFilter, FilterType } from "../filter.slint";
import { IconBtn, Divider, Label } from "../../../../base/widgets.slint";
import { MoveHandle } from "move-handle.slint";

export component PreviewRectangleMaskLayer inherits Rectangle {
    in-out property <[VideoEditorLayerImage]> layers;
    private property <float> width-hight-rate: self.width / self.height;
    private property <FilterType> selected-filter-type <=> VEFilter.selected-filter.ty;

    for index in layers.length: rec := Rectangle {
        x: 0;
        y: 0;

        private property <VideoEditorLayerImage> layer: layers[layers.length - 1 - index];
        private property <bool> is-edited-track: Store.video-editor-current-edited-track-index == layer.track-index;
        private property <bool> has-keyframes: Logic.video-editor-segment-has-keyframes(layer.track-index, layer.segment-index);
        private property <RectangleMaskDetail> config: is-edited-track && has-keyframes ? VEFilter.from-rectangle-mask-json(VEFilter.selected-filter.detail) : layer.rectangle-mask;
        private property <bool> is-previewing: Store.video-editor-is-previewing;

        changed is-previewing => {
            if (is-edited-track && !is-previewing && has-keyframes) {
                VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);
            }
        }

        container-rec := Rectangle {
            width: img.width;
            height: img.height;

            img := Image {
                private property <length> parent-width: rec.width;
                private property <length> parent-height: rec.height;
                private property <float> width-hight-rate: self.source.width / self.source.height;

                changed parent-width => {
                    self.update-size();
                }

                changed parent-height => {
                    self.update-size();
                }

                function update-size() {
                    if (root.width-hight-rate > self.width-hight-rate) {
                        self.height = root.height;
                        self.width = self.height * self.width-hight-rate;
                    } else {
                        self.width = root.width;
                        self.height = self.width / self.width-hight-rate;
                    }
                }

                // Apply resize for the rectangle mask (center-based coordinates)
                // handle: 1=top-left, 2=top-right, 3=bottom-right, 4=bottom-left
                //         5=top-edge, 6=right-edge, 7=bottom-edge, 8=left-edge
                function apply-resize(screen-diff-x: length, screen-diff-y: length, handle: int, orig-cx: float, orig-cy: float, orig-w: float, orig-h: float) {
                    let min-size-norm = Theme.icon-size / self.width;

                    // Work in pixel space for rotation to maintain correct aspect ratio
                    let diff-px-x = screen-diff-x / 1px;
                    let diff-px-y = screen-diff-y / 1px;

                    // Rotate screen pixel delta into the rectangle's local coordinate system
                    let rotation-deg = config.rotation;
                    let cos-val = cos(1deg * rotation-deg);
                    let sin-val = sin(1deg * rotation-deg);
                    // Inverse rotation in pixel space (accounts for aspect ratio correctly)
                    let local-px-x = diff-px-x * cos-val + diff-px-y * sin-val;
                    let local-px-y = -diff-px-x * sin-val + diff-px-y * cos-val;

                    // Convert local pixel delta back to normalized values
                    // x normalized by width, y normalized by height (same as Rust filter)
                    let local-x = local-px-x / (self.width / 1px);
                    let local-y = local-px-y / (self.height / 1px);

                    if (handle == 1) { // top-left corner
                        let new-w = orig-w - local-x;
                        let new-h = orig-h - local-y;
                        if (new-w >= min-size-norm) {
                            config.width = new-w;
                            config.center-x = orig-cx + local-x / 2;
                        }
                        if (new-h >= min-size-norm) {
                            config.height = new-h;
                            config.center-y = orig-cy + local-y / 2;
                        }
                    } else if (handle == 2) { // top-right corner
                        let new-w = orig-w + local-x;
                        let new-h = orig-h - local-y;
                        if (new-w >= min-size-norm) {
                            config.width = new-w;
                            config.center-x = orig-cx + local-x / 2;
                        }
                        if (new-h >= min-size-norm) {
                            config.height = new-h;
                            config.center-y = orig-cy + local-y / 2;
                        }
                    } else if (handle == 3) { // bottom-right corner
                        let new-w = orig-w + local-x;
                        let new-h = orig-h + local-y;
                        if (new-w >= min-size-norm) {
                            config.width = new-w;
                            config.center-x = orig-cx + local-x / 2;
                        }
                        if (new-h >= min-size-norm) {
                            config.height = new-h;
                            config.center-y = orig-cy + local-y / 2;
                        }
                    } else if (handle == 4) { // bottom-left corner
                        let new-w = orig-w - local-x;
                        let new-h = orig-h + local-y;
                        if (new-w >= min-size-norm) {
                            config.width = new-w;
                            config.center-x = orig-cx + local-x / 2;
                        }
                        if (new-h >= min-size-norm) {
                            config.height = new-h;
                            config.center-y = orig-cy + local-y / 2;
                        }
                    } else if (handle == 5) { // top edge
                        let new-h = orig-h - local-y;
                        if (new-h >= min-size-norm) {
                            config.height = new-h;
                            config.center-y = orig-cy + local-y / 2;
                        }
                    } else if (handle == 6) { // right edge
                        let new-w = orig-w + local-x;
                        if (new-w >= min-size-norm) {
                            config.width = new-w;
                            config.center-x = orig-cx + local-x / 2;
                        }
                    } else if (handle == 7) { // bottom edge
                        let new-h = orig-h + local-y;
                        if (new-h >= min-size-norm) {
                            config.height = new-h;
                            config.center-y = orig-cy + local-y / 2;
                        }
                    } else if (handle == 8) { // left edge
                        let new-w = orig-w - local-x;
                        if (new-w >= min-size-norm) {
                            config.width = new-w;
                            config.center-x = orig-cx + local-x / 2;
                        }
                    }

                    // Enforce boundary constraints: only keep center within [0, 1]
                    config.width = clamp(config.width, min-size-norm, 1.0);
                    config.height = clamp(config.height, min-size-norm, 1.0);
                    config.center-x = clamp(config.center-x, 0.0, 1.0);
                    config.center-y = clamp(config.center-y, 0.0, 1.0);
                }

                init => {
                    self.update-size();
                }

                source: layer.original-image;
                image-fit: ImageFit.contain;
            }

            if is-edited-track: Rectangle {
                width: img.width;
                height: img.height;

                // Precompute rotation values
                private property <float> sin-val: sin(1deg * config.rotation);
                private property <float> cos-val: cos(1deg * config.rotation);

                // Rectangle center in pixels
                private property <float> cx-px: config.center-x * img.width / 1px;
                private property <float> cy-px: config.center-y * img.height / 1px;

                // Half dimensions in pixels
                private property <float> half-w-px: config.width * img.width / 1px / 2;
                property <float> half-h-px: config.height * img.height / 1px / 2;

                // Corner positions in local frame relative to center, then rotated to screen
                // top-left: (-half_w, -half_h)
                private property <float> tl-x: cx-px + (-half-w-px) * cos-val - (-half-h-px) * sin-val;
                private property <float> tl-y: cy-px + (-half-w-px) * sin-val + (-half-h-px) * cos-val;
                // top-right: (half_w, -half_h)
                private property <float> tr-x: cx-px + half-w-px * cos-val - (-half-h-px) * sin-val;
                private property <float> tr-y: cy-px + half-w-px * sin-val + (-half-h-px) * cos-val;
                // bottom-right: (half_w, half_h)
                private property <float> br-x: cx-px + half-w-px * cos-val - half-h-px * sin-val;
                private property <float> br-y: cy-px + half-w-px * sin-val + half-h-px * cos-val;
                // bottom-left: (-half_w, half_h)
                private property <float> bl-x: cx-px + (-half-w-px) * cos-val - half-h-px * sin-val;
                private property <float> bl-y: cy-px + (-half-w-px) * sin-val + half-h-px * cos-val;

                // Edge midpoints
                private property <float> top-mid-x: (tl-x + tr-x) / 2;
                private property <float> top-mid-y: (tl-y + tr-y) / 2;
                private property <float> right-mid-x: (tr-x + br-x) / 2;
                private property <float> right-mid-y: (tr-y + br-y) / 2;
                private property <float> bottom-mid-x: (bl-x + br-x) / 2;
                private property <float> bottom-mid-y: (bl-y + br-y) / 2;
                private property <float> left-mid-x: (tl-x + bl-x) / 2;
                private property <float> left-mid-y: (tl-y + bl-y) / 2;

                // Store original values when drag starts
                private property <float> orig-cx;
                private property <float> orig-cy;
                private property <float> orig-w;
                private property <float> orig-h;

                // Store initial mouse position when drag starts for handles
                private property <length> handle-pressed-x;
                private property <length> handle-pressed-y;

                // Move by dragging inside the rectangle
                TouchArea {
                    width: img.width;
                    height: img.height;
                    mouse-cursor: self.pressed ? grabbing : grab;

                    private property <float> move-orig-cx;
                    private property <float> move-orig-cy;

                    scroll-event(event) => {
                        let scale = 1.0 - event.delta-y / 1px * 0.001;

                        let mouse-norm-x = self.mouse-x / img.width;
                        let mouse-norm-y = self.mouse-y / img.height;

                        let new-w = clamp(config.width * scale, Theme.icon-size / img.width, 1.0);
                        let new-h = clamp(config.height * scale, Theme.icon-size / img.width, 1.0);

                        // Adjust center so the point under cursor stays fixed
                        config.center-x = clamp(mouse-norm-x - (mouse-norm-x - config.center-x) * (new-w / config.width), 0.0, 1.0);
                        config.center-y = clamp(mouse-norm-y - (mouse-norm-y - config.center-y) * (new-h / config.height), 0.0, 1.0);

                        config.width = new-w;
                        config.height = new-h;

                        VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);

                        accept
                    }

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            move-orig-cx = config.center-x;
                            move-orig-cy = config.center-y;
                        }
                    }

                    moved => {
                        let norm-x = (self.mouse-x - self.pressed-x) / img.width;
                        let norm-y = (self.mouse-y - self.pressed-y) / img.height;

                        let new-cx = move-orig-cx + norm-x;
                        let new-cy = move-orig-cy + norm-y;

                        config.center-x = clamp(new-cx, 0.0, 1.0);
                        config.center-y = clamp(new-cy, 0.0, 1.0);
                    }

                    changed pressed => {
                        if (!self.pressed) {
                            VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);
                        }
                    }
                }

                // Rectangle outline - rotated around center using transform-origin
                outline-rec := Rectangle {
                    x: (config.center-x - config.width / 2) * img.width;
                    y: (config.center-y - config.height / 2) * img.height;
                    width: config.width * img.width;
                    height: config.height * img.height;

                    border-width: 2px;
                    border-color: white;
                    background: transparent;

                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    transform-rotation: 1deg * config.rotation;
                }

                // --- Corner handles (positioned at rotated corner positions) ---
                // Top-left handle
                top-left-handle := MoveHandle {
                    x: parent.tl-x * 1px - self.width / 2;
                    y: parent.tl-y * 1px - self.height / 2;
                    index: 1;

                    pressed-changed => {
                        orig-cx = config.center-x;
                        orig-cy = config.center-y;
                        orig-w = config.width;
                        orig-h = config.height;
                        handle-pressed-x = self.x + self.mouse-x;
                        handle-pressed-y = self.y + self.mouse-y;
                    }

                    moved => {
                        let current-x = self.x + self.mouse-x;
                        let current-y = self.y + self.mouse-y;
                        img.apply-resize(current-x - handle-pressed-x, current-y - handle-pressed-y, 1,
                                          orig-cx, orig-cy, orig-w, orig-h);
                    }

                    released => {
                        VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);
                    }
                }

                // Top-right handle
                top-right-handle := MoveHandle {
                    x: parent.tr-x * 1px - self.width / 2;
                    y: parent.tr-y * 1px - self.height / 2;
                    index: 2;

                    pressed-changed => {
                        orig-cx = config.center-x;
                        orig-cy = config.center-y;
                        orig-w = config.width;
                        orig-h = config.height;
                        handle-pressed-x = self.x + self.mouse-x;
                        handle-pressed-y = self.y + self.mouse-y;
                    }

                    moved => {
                        let current-x = self.x + self.mouse-x;
                        let current-y = self.y + self.mouse-y;
                        img.apply-resize(current-x - handle-pressed-x, current-y - handle-pressed-y, 2,
                                          orig-cx, orig-cy, orig-w, orig-h);
                    }

                    released => {
                        VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);
                    }
                }

                // Bottom-right handle
                bottom-right-handle := MoveHandle {
                    x: parent.br-x * 1px - self.width / 2;
                    y: parent.br-y * 1px - self.height / 2;
                    index: 3;

                    pressed-changed => {
                        orig-cx = config.center-x;
                        orig-cy = config.center-y;
                        orig-w = config.width;
                        orig-h = config.height;
                        handle-pressed-x = self.x + self.mouse-x;
                        handle-pressed-y = self.y + self.mouse-y;
                    }

                    moved => {
                        let current-x = self.x + self.mouse-x;
                        let current-y = self.y + self.mouse-y;
                        img.apply-resize(current-x - handle-pressed-x, current-y - handle-pressed-y, 3,
                                          orig-cx, orig-cy, orig-w, orig-h);
                    }

                    released => {
                        VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);
                    }
                }

                // Bottom-left handle
                bottom-left-handle := MoveHandle {
                    x: parent.bl-x * 1px - self.width / 2;
                    y: parent.bl-y * 1px - self.height / 2;
                    index: 4;

                    pressed-changed => {
                        orig-cx = config.center-x;
                        orig-cy = config.center-y;
                        orig-w = config.width;
                        orig-h = config.height;
                        handle-pressed-x = self.x + self.mouse-x;
                        handle-pressed-y = self.y + self.mouse-y;
                    }

                    moved => {
                        let current-x = self.x + self.mouse-x;
                        let current-y = self.y + self.mouse-y;
                        img.apply-resize(current-x - handle-pressed-x, current-y - handle-pressed-y, 4,
                                          orig-cx, orig-cy, orig-w, orig-h);
                    }

                    released => {
                        VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);
                    }
                }

                // --- Edge handles ---
                // Top edge handle
                top-edge-handle := Rectangle {
                    x: parent.top-mid-x * 1px - self.width / 2;
                    y: parent.top-mid-y * 1px - self.height / 2;
                    width: Theme.icon-size * 0.7;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: white;
                    border-width: 1px;
                    border-color: Theme.thirdly-brand-color;

                    TouchArea {
                        mouse-cursor: ns-resize;

                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                orig-cx = config.center-x;
                                orig-cy = config.center-y;
                                orig-w = config.width;
                                orig-h = config.height;
                                handle-pressed-x = parent.x + self.mouse-x;
                                handle-pressed-y = parent.y + self.mouse-y;
                            }
                        }

                        moved => {
                            if (self.pressed) {
                                let diff-x = (parent.x + self.mouse-x) - handle-pressed-x;
                                let diff-y = (parent.y + self.mouse-y) - handle-pressed-y;
                                img.apply-resize(diff-x, diff-y, 5, orig-cx, orig-cy, orig-w, orig-h);
                            }
                        }

                        changed pressed => {
                            if (!self.pressed) {
                                VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);
                            }
                        }
                    }
                }

                // Bottom edge handle
                bottom-edge-handle := Rectangle {
                    x: parent.bottom-mid-x * 1px - self.width / 2;
                    y: parent.bottom-mid-y * 1px - self.height / 2;
                    width: Theme.icon-size * 0.7;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: white;
                    border-width: 1px;
                    border-color: Theme.thirdly-brand-color;

                    TouchArea {
                        mouse-cursor: ns-resize;

                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                orig-cx = config.center-x;
                                orig-cy = config.center-y;
                                orig-w = config.width;
                                orig-h = config.height;
                                handle-pressed-x = parent.x + self.mouse-x;
                                handle-pressed-y = parent.y + self.mouse-y;
                            }
                        }

                        moved => {
                            if (self.pressed) {
                                let diff-x = (parent.x + self.mouse-x) - handle-pressed-x;
                                let diff-y = (parent.y + self.mouse-y) - handle-pressed-y;
                                img.apply-resize(diff-x, diff-y, 7, orig-cx, orig-cy, orig-w, orig-h);
                            }
                        }

                        changed pressed => {
                            if (!self.pressed) {
                                VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);
                            }
                        }
                    }
                }

                // Left edge handle
                left-edge-handle := Rectangle {
                    x: parent.left-mid-x * 1px - self.width / 2;
                    y: parent.left-mid-y * 1px - self.height / 2;
                    width: Theme.icon-size * 0.7;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: white;
                    border-width: 1px;
                    border-color: Theme.thirdly-brand-color;

                    TouchArea {
                        mouse-cursor: ew-resize;

                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                orig-cx = config.center-x;
                                orig-cy = config.center-y;
                                orig-w = config.width;
                                orig-h = config.height;
                                handle-pressed-x = parent.x + self.mouse-x;
                                handle-pressed-y = parent.y + self.mouse-y;
                            }
                        }

                        moved => {
                            if (self.pressed) {
                                let diff-x = (parent.x + self.mouse-x) - handle-pressed-x;
                                let diff-y = (parent.y + self.mouse-y) - handle-pressed-y;
                                img.apply-resize(diff-x, diff-y, 8, orig-cx, orig-cy, orig-w, orig-h);
                            }
                        }

                        changed pressed => {
                            if (!self.pressed) {
                                VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);
                            }
                        }
                    }
                }

                // Right edge handle
                right-edge-handle := Rectangle {
                    x: parent.right-mid-x * 1px - self.width / 2;
                    y: parent.right-mid-y * 1px - self.height / 2;
                    width: Theme.icon-size * 0.7;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: white;
                    border-width: 1px;
                    border-color: Theme.thirdly-brand-color;

                    TouchArea {
                        mouse-cursor: ew-resize;

                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                orig-cx = config.center-x;
                                orig-cy = config.center-y;
                                orig-w = config.width;
                                orig-h = config.height;
                                handle-pressed-x = parent.x + self.mouse-x;
                                handle-pressed-y = parent.y + self.mouse-y;
                            }
                        }

                        moved => {
                            if (self.pressed) {
                                let diff-x = (parent.x + self.mouse-x) - handle-pressed-x;
                                let diff-y = (parent.y + self.mouse-y) - handle-pressed-y;
                                img.apply-resize(diff-x, diff-y, 6, orig-cx, orig-cy, orig-w, orig-h);
                            }
                        }

                        changed pressed => {
                            if (!self.pressed) {
                                VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);
                            }
                        }
                    }
                }

                // Line from center to rotation handle
                Rectangle {
                    clip: true;

                    line-rec := Rectangle {
                        x: (center-handle.x + center-handle.width / 2);
                        y: (center-handle.y + center-handle.height / 2);
                        width: 2px;
                        height: sqrt((rotation-handle.x + rotation-handle.width / 2 - center-handle.x - center-handle.width / 2) / 1px * ((rotation-handle.x + rotation-handle.width / 2 - center-handle.x - center-handle.width / 2) / 1px) + (rotation-handle.y + rotation-handle.height / 2 - center-handle.y - center-handle.height / 2) / 1px * ((rotation-handle.y + rotation-handle.height / 2 - center-handle.y - center-handle.height / 2) / 1px)) * 1px;
                        background: white;
                        transform-origin: { x: 0px, y: 0px };
                        transform-rotation: 1deg * (-atan2((rotation-handle.x + rotation-handle.width / 2 - center-handle.x - center-handle.width / 2) / 1px, (rotation-handle.y + rotation-handle.height / 2 - center-handle.y - center-handle.height / 2) / 1px) / 1deg);
                    }
                }

                // Center handle
                center-handle := Rectangle {
                    x: config.center-x * parent.width - self.width / 2;
                    y: config.center-y * parent.height - self.height / 2;
                    width: Theme.default-font-size;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: white;

                    TouchArea {
                        private property <bool> can-move;
                        mouse-cursor: move;

                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left) {
                                if (event.kind == PointerEventKind.down) {
                                    can-move = true;
                                } else if (event.kind == PointerEventKind.up) {
                                    can-move = false;
                                    VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);
                                }
                            }
                        }

                        moved => {
                            if (!can-move) {
                                return;
                            }
                            let x = clamp(parent.x + self.mouse-x - self.pressed-x, 0, img.width - parent.width);
                            let y = clamp(parent.y + self.mouse-y - self.pressed-y, 0, img.height - parent.height);
                            config.center-x = clamp((x + parent.width / 2) / img.width, 0.0, 1.0);
                            config.center-y = clamp((y + parent.height / 2) / img.height, 0.0, 1.0);
                        }
                    }
                }

                // Rotation handle
                rotation-handle := Rectangle {
                    private property <float> handle-distance: Theme.icon-size / 1px * 3;
                    x: config.center-x * parent.width - self.handle-distance * sin-val * 1px - self.width / 2;
                    y: config.center-y * parent.height + self.handle-distance * cos-val * 1px - self.height / 2;
                    width: Theme.icon-size * 1.5;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: white;

                    Image {
                        source: Icons.rotation-fill;
                        width: Theme.icon-size;
                        height: self.width;
                        image-fit: contain;
                        colorize: Theme.danger-color;
                    }

                    TouchArea {
                        private property <bool> can-rotate;
                        private property <float> start-angle;

                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left) {
                                if (event.kind == PointerEventKind.down) {
                                    can-rotate = true;
                                    let cx = config.center-x * img.width / 1px;
                                    let cy = config.center-y * img.height / 1px;
                                    let mx = (parent.x + self.mouse-x + parent.width / 2) / 1px;
                                    let my = (parent.y + self.mouse-y + parent.height / 2) / 1px;
                                    start-angle = atan2(my - cy, mx - cx) / 1deg;
                                } else if (event.kind == PointerEventKind.up) {
                                    can-rotate = false;
                                    VEFilter.modify-rectangle-mask-filter(VEFilter.selected-filter-index, config, selected-filter-type);
                                }
                            }
                        }

                        moved => {
                            if (!can-rotate) {
                                return;
                            }
                            let cx = config.center-x * img.width / 1px;
                            let cy = config.center-y * img.height / 1px;
                            let mx = (parent.x + self.mouse-x + parent.width / 2) / 1px;
                            let my = (parent.y + self.mouse-y + parent.height / 2) / 1px;
                            let current-angle = atan2(my - cy, mx - cx) / 1deg;
                            let delta = current-angle - start-angle;
                            start-angle = current-angle;
                            config.rotation = Math.mod(config.rotation + delta, 360.0);
                        }
                    }
                }
            }
        }
    }
}
