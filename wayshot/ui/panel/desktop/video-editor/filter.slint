    get-segment-filter-keyframes => {
        return [{ time-ms: 3000 }, { time-ms: 6000 }];
    }

    scale-pixel-for-resolution(pixel-value, target-height) => {
        let scale = target-height / 1080.0;
        return (pixel-value * scale).round();
    }

    public function is-edit-mode-filter(filter-name: string) -> bool {
        let name = filter-name.to-lowercase();
        return name == "transform" || name == "crop" || name == "zoom" || name == "fly in" || name == "mosaic" || name == "liquid glass" || name == "draw circle" || name == "draw rectangle" || name == "local magnify" || name == "magnifier" || name == "text highlight" || name == "linear mask" || name == "circle mask" || name == "mirror mask" || name == "rectangle mask" || name == "focus" || name == "gaussian blur";
    }

    pure public function filter-type-to-int(ty: FilterType) -> int {
        if (ty == FilterType.Video) {
            return 0;
        } else if (ty == FilterType.Image) {
            return 1;
        } else if (ty == FilterType.Audio) {
            return 2;
        } else if (ty == FilterType.Subtitle) {
            return 3;
        } else {
            return 0;
        }
    }

    pure public function filter-type-from-int(index: int) -> FilterType {
        if (index == 0) {
            return FilterType.Video;
        } else if (index == 1) {
            return FilterType.Image;
        } else if (index == 2) {
            return FilterType.Audio;
        } else if (index == 3) {
            return FilterType.Subtitle;
        } else {
            return FilterType.Video;
        }
    }

    pure public function make-float-value(v: float) -> KeyframeValue {
        {
            float-value: v,
            float2-value-x: 0.0,
            float2-value-y: 0.0,
            color-r: 255,
            color-g: 255,
            color-b: 255,
            color-a: 255,
            bool-value: false,
            value-type: KeyframeValueType.Float,
        }
    }

    pure public function make-float2-value(x: float, y: float) -> KeyframeValue {
        {
            float-value: 0.0,
            float2-value-x: x,
            float2-value-y: y,
            color-r: 255,
            color-g: 255,
            color-b: 255,
            color-a: 255,
            bool-value: false,
            value-type: KeyframeValueType.Float2,
        }
    }

    pure public function make-color-value(r: int, g: int, b: int, a: int) -> KeyframeValue {
        {
            float-value: 0.0,
            float2-value-x: 0.0,
            float2-value-y: 0.0,
            color-r: r,
            color-g: g,
            color-b: b,
            color-a: a,
            bool-value: false,
            value-type: KeyframeValueType.Color,
        }
    }
}
