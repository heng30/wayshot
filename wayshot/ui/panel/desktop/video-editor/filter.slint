export enum FilterType { Video, Audio, Image, Subtitle }

export struct FilterEntry {
    ty: FilterType,
    name: string,
    is-marked: bool,
}

export struct SegmentFilter {
    ty: FilterType,
    enabled: bool,
    name: string,
    detail: string, // 经过序列化后的json
}

export struct PresetFilter {
    name: string,
    filters: [SegmentFilter],
}

// ==================== Keyframe Types ====================

export enum KeyframeValueType { Float, Float2, Color, Bool }

export struct KeyframeValue {
    float-value: float,
    float2-value-x: float,
    float2-value-y: float,
    color-r: int,
    color-g: int,
    color-b: int,
    color-a: int,
    bool-value: bool,
    value-type: KeyframeValueType,
}

export struct Keyframe {
    time-ms: int,
    value: KeyframeValue,
}

export struct PropertyTrack {
    filter-name: string,
    property-name: string,
    keyframes: [Keyframe],
}

export struct AnimatableProperty {
    name: string,
    display-name: string,
    min-value: float,
    max-value: float,
    default-value: KeyframeValue,
}

// ==================== Video Filters ====================

export struct CropDetail {
    left: float,
    top: float,
    width: float,
    height: float,
    shape: int,  // 0=Rectangle, 1=Circle
}

export struct FlipDetail {
    direction: int, // 0=Horizontal, 1=Vertical, 2=Both
}

export struct ChromaKeyDetail {
    target-color-r: int,
    target-color-g: int,
    target-color-b: int,
    target-color-a: int,
    similarity: float,
    softness: float,
    feather: float,
    spill-reduction: float,
}

export struct ZoomDetail {
    relative-start-ms: int,
    zoom-in-duration-ms: int,
    hold-duration-ms: int,
    zoom-out-duration-ms: int,
    level: float,       // Zoom level (0.0-1.0, smaller = zoom in more, e.g., 0.5 = 2x zoom)
    center-x: float,
    center-y: float,
}

export struct TransformDetail {
    zoom-level: float,
    center-x-percent: float, // 图层中心在背景图片的位置([0, 1])
    center-y-percent: float, // 图层中心在背景图片的位置([0, 1])
    rotation: angle,
}

export struct DrawCircleDetail {
    center-x: float,
    center-y: float,
    radius: int,
    fill-color-r: int,
    fill-color-g: int,
    fill-color-b: int,
    fill-color-a: int,
    border-color-r: int,
    border-color-g: int,
    border-color-b: int,
    border-color-a: int,
    border-width: int,
}

export struct DrawRectangleDetail {
    x: float,
    y: float,
    width: float,
    height: float,
    fill-color-r: int,
    fill-color-g: int,
    fill-color-b: int,
    fill-color-a: int,
    border-color-r: int,
    border-color-g: int,
    border-color-b: int,
    border-color-a: int,
    border-width: int,
    corner-radius: int,
}

export struct LocalMagnifyDetail {
    center-x: float,
    center-y: float,
    selection-radius: int,    // 选中区域半径 (基于1080p)
    scale: float,             // 缩放倍数 (1.0-10.0)
    border-color-r: int,
    border-color-g: int,
    border-color-b: int,
    border-color-a: int,
    border-width: int,
}

export struct MagnifierDetail {
    center-x: float,          // 0.0-1.0
    center-y: float,          // 0.0-1.0
    radius: int,              // 放大镜半径 (基于1080p)
    scale: float,             // 缩放倍数 (1.0-10.0)
    border-color-r: int,
    border-color-g: int,
    border-color-b: int,
    border-color-a: int,
    border-width: int,
}

// ==================== Audio Filters ====================

export struct GainDetail {
    amplitude: float, // 1.0 = no change
}

export struct FadeInDetail {
    duration-ms: int,
}

export struct FadeOutDetail {
    duration-ms: int,
}

export struct CompressorDetail {
    threshold: float, // dB
    ratio: float,
    attack: float,    // ms
    release: float,   // ms
    makeup-gain: float, // dB
}

export struct LimiterDetail {
    threshold: float, // dB
}

export struct NoiseGateDetail {
    threshold: float, // dB
    ratio: float,
    attack: float,    // ms
    hold: float,      // ms
    release: float,   // ms
}

export struct NormalizeDetail {
    target-level-db: float,
}

export struct MuteDetail {
    channel: int,  // 0=Left, 1=Right, 2=Both
}

export struct CopyChannelDetail {
    direction: int,  // 0=LeftToRight, 1=RightToLeft
}

export struct VoiceChangerDetail {
    pitch-semitones: float,  // -12 to +12
    formant-semitones: float, // -6 to +6
}

// ==================== Image Filters ====================

export struct FlyInDetail {
    duration-ms: int,
    direction: int,  // 0=FromLeft, 1=FromRight, 2=FromTop, 3=FromBottom
    move-to-x: float,
    move-to-y: float,
    easing: int, // 0=Linear, 1=EaseIn, 2=EaseOut, 3=EaseInOut
}

export struct VideoFadeInDetail {
    duration-ms: int,
}

export struct VideoFadeOutDetail {
    duration-ms: int,
}

export struct SlideDetail {
    direction: int,  // 0=FromLeft, 1=FromRight, 2=FromTop, 3=FromBottom
    position: int,   // 0=Start, 1=End
    duration-ms: int,
}

export struct WipeDetail {
    direction: int,  // 0=LeftToRight, 1=RightToLeft, 2=TopToBottom, 3=BottomToTop
    duration-ms: int,
}

export struct OpacityDetail {
    opacity: float,  // 0.0-1.0
}

export struct VignetteDetail {
    intensity: float,    // 0.0-1.0, how dark the vignette gets
    inner-radius: float, // 0.0-1.0, where vignette starts (bright area)
    outer-radius: float, // 0.0-1.0, where vignette reaches max darkness
    center-x: float,     // 0.0-1.0, center position
    center-y: float,     // 0.0-1.0, center position
}

export struct LinearMaskDetail {
    center-x: float,     // 0.0-1.0, line center position
    center-y: float,     // 0.0-1.0, line center position
    rotation: float,     // 0.0-360.0, rotation degrees
    feather: float,      // 0.0-1.0, edge softness
    opacity: float,      // 0.0-1.0, mask opacity
    flip: bool,          // flip mask side
}

export struct CircleMaskDetail {
    center-x: float,     // 0.0-1.0, center position
    center-y: float,     // 0.0-1.0, center position
    rotation: float,     // 0.0-360.0, rotation degrees
    feather: float,      // 0.0-1.0, edge softness
    opacity: float,      // 0.0-1.0, mask opacity
    flip: bool,          // flip mask side
    radius: int,         // pixel radius (based on 1080p)
}

export struct MirrorMaskDetail {
    center-x: float,     // 0.0-1.0, center position
    center-y: float,     // 0.0-1.0, center position
    rotation: float,     // 0.0-360.0, rotation degrees
    feather: float,      // 0.0-1.0, edge softness
    opacity: float,      // 0.0-1.0, mask opacity
    flip: bool,          // flip mask side
    width: float,        // 0.0-1.0, band width
}

export struct RectangleMaskDetail {
    center-x: float,     // 0.0-1.0, center position
    center-y: float,     // 0.0-1.0, center position
    rotation: float,     // 0.0-360.0, rotation degrees
    feather: float,      // 0.0-1.0, edge softness
    opacity: float,      // 0.0-1.0, mask opacity
    flip: bool,          // flip mask side
    width: float,        // 0.0-1.0, rectangle width
    height: float,       // 0.0-1.0, rectangle height
}

export struct HslAdjustDetail {
    hue-shift: float,           // -180.0 to 180.0
    saturation: float,          // -1.0 to 1.0
    lightness: float,           // -1.0 to 1.0
    preserve-luminance: bool,
    luminance-standard: int,    // 0=BT709, 1=BT601, 2=BT2020
}

export struct BorderDetail {
    size: int,
    color-r: int,
    color-g: int,
    color-b: int,
    color-a: int,
    corner-radius: int,
}

export struct BackgroundDetail {
    color-r: int,
    color-g: int,
    color-b: int,
    color-a: int,
}

export struct MosaicDetail {
    left: float,
    top: float,
    width: float,
    height: float,
    block-size: int,
}

export struct LiquidGlassDetail {
    x: float,
    y: float,
    width: float,
    height: float,
    corner-radius: float,
    refraction-height: float,
    refraction-amount: float,
    blur-radius: float,
    chromatic-aberration: float,
    depth-effect: float,
    contrast: float,
    white-point: float,
    chroma-multiplier: float,
    tint-alpha: float,
    tint-color-r: float,
    tint-color-g: float,
    tint-color-b: float,
}

export struct SpeedDetail {
    speed: float,  // 0.1-10.0, 播放速度倍率
}

export struct FrameExtractDetail {
    frame-interval: int,  // >=1, 每隔多少帧抽取一帧
}

export struct BreathingDetail {
    center-x: float,               // 0.0-1.0, 缩放中心X
    center-y: float,               // 0.0-1.0, 缩放中心Y
    min-scale: float,              // 0.1-1.0, 最小缩放比例
    breathing-duration-ms: int,    // 呼吸周期的时长（毫秒）
    curve: int,                    // 0: Linear, 1: EaseInOut (default)
}

export struct GaussianBlurDetail {
    radius: float,    // 0.0-50.0, 模糊半径
    sigma: float,     // 0.1-20.0, 高斯分布标准差
    left: float,      // 0.0-1.0, 模糊区域左边缘
    top: float,       // 0.0-1.0, 模糊区域上边缘
    width: float,     // 0.0-1.0, 模糊区域宽度
    height: float,    // 0.0-1.0, 模糊区域高度
}

export struct DirectionalBlurDetail {
    angle: float,     // 0.0-360.0, 模糊方向角度
    length: float,    // 0.0-100.0, 模糊长度/距离
    spread: float,    // 0.0-1.0, 模糊扩散/柔和度
}

export struct SharpenDetail {
    strength: float,    // 0.0-5.0, 锐化强度
    radius: float,      // 0.0-10.0, 锐化半径
}

export struct EdgeDetectDetail {
    threshold: float,       // 0-255, 边缘阈值
    strength: float,        // 0.0-2.0, 边缘强度
    invert: bool,           // 是否反转边缘/背景颜色
    edge-color-r: int,      // 边缘颜色RGBA
    edge-color-g: int,
    edge-color-b: int,
    edge-color-a: int,
    background-color-r: int,    // 背景颜色RGBA
    background-color-g: int,
    background-color-b: int,
    background-color-a: int,
}

export struct GrainDetail {
    intensity: float,       // 0.0-1.0, 颗粒强度
    grain-size: float,      // 1.0-10.0, 颗粒大小
    colored: bool,          // 是否彩色颗粒
    roughness: float,       // 0.0-1.0, 粗糙度
    seed: int,              // 随机种子
}

export struct FisheyeDetail {
    center-x: float,        // 0.0-1.0, 中心点 X
    center-y: float,        // 0.0-1.0, 中心点 Y
    strength: float,        // -1.0-2.0, 变形强度
    radius: int,            // 像素半径 (基于1080p)
}

export struct FocusDetail {
    center-x: float,        // 0.0-1.0, 焦点中心 X
    center-y: float,        // 0.0-1.0, 焦点中心 Y
    focus-radius: int,      // 像素半径 (基于1080p), 清晰区域半径
    feather: int,           // 像素宽度 (基于1080p), 焦点边缘过渡
    blur-radius: int,       // 像素半径 (基于1080p), 虚化模糊强度
    aperture-blades: int,   // 3-12, 光圈叶片数
    highlight-boost: float, // 0.0-2.0, 高光增强
}

export struct GrayscaleDetail {
    intensity: float,           // 0.0-1.0, 灰度强度
    contrast: float,            // -1.0-1.0, 对比度
    luminance-standard: int,    // 0=BT709, 1=BT601, 2=BT2020
}

export struct OldFilmDetail {
    seed: int,
    scratch-intensity: float,       // 0.0-1.0
    scratch-count: int,
    scratch-width: int,
    dust-intensity: float,          // 0.0-1.0
    dust-count: int,
    dust-size-max: int,
    flicker-intensity: float,       // 0.0-0.3
    flicker-speed: float,           // 1.0-10.0
    vertical-lines-intensity: float, // 0.0-1.0
    vertical-lines-count: int,
    jitter-intensity: float,        // 0.0-10.0
    sepia-intensity: float,         // 0.0-1.0
}

export struct SketchDetail {
    line-intensity: float,      // 0.0-1.0, 线条强度
    line-width: float,          // 1.0-10.0, 线条宽度
    detail-level: float,        // 0.0-1.0, 细节级别
    paper-color-r: int,
    paper-color-g: int,
    paper-color-b: int,
    paper-color-a: int,
    pencil-color-r: int,
    pencil-color-g: int,
    pencil-color-b: int,
    pencil-color-a: int,
}

export struct WaveDetail {
    amplitude: float,           // 0.0-100.0, 波浪振幅
    frequency: float,           // 0.1-10.0, 波浪频率
    speed: float,               // 0.0-10.0, 波浪速度
    phase: float,               // 0.0-360.0, 相位偏移
    wave-type: int,             // 0=Horizontal, 1=Vertical, 2=Radial, 3=Concentric
    center-x: float,            // 0.0-1.0, 中心点 X
    center-y: float,            // 0.0-1.0, 中心点 Y
}

export struct HighlightRegionDetail {
    x: float,      // normalized 0-1
    y: float,      // normalized 0-1
    width: float,  // normalized 0-1
    height: float, // normalized 0-1
}

export struct TextHighlightDetail {
    highlight-color-r: int,
    highlight-color-g: int,
    highlight-color-b: int,
    highlight-color-a: int,
    background-color-r: int,
    background-color-g: int,
    background-color-b: int,
    pixel-per-second: int,
    invert: bool,
    similarity-threshold: float,
    regions: [HighlightRegionDetail],
}

export struct ShadowDetail {
    color-r: int,
    color-g: int,
    color-b: int,
    color-a: int,
    opacity: float,     // 0.0-1.0
    size: float,        // 0.0-1.0
    blur: float,        // 0.0-100.0
    angle: float,       // 0.0-360.0
    distance: float,    // 0.0-200.0
}

export struct GridDetail {
    rows: int,
    columns: int,
    line-size: int,
    line-color-r: int,
    line-color-g: int,
    line-color-b: int,
    line-color-a: int,
}

export struct DeviceFrameDetail {
    device-name: string,
    screen-background-r: int,
    screen-background-g: int,
    screen-background-b: int,
    screen-background-a: int,
}

export struct GenieDetail {
    position: int,       // EffectPosition enum as int
    duration: int,       // milliseconds
    anchor: int,         // GenieAnchor enum as int
    funnel-power: float, // 1.0-4.0
    shadow: float,       // 0.0-1.0
    easing: int,         // EasingFunction enum as int
}

export struct WindScatterDetail {
    position: int,           // EffectPosition enum as int (0=Start reassemble, 1=End scatter)
    duration: int,           // milliseconds
    angle-deg: float,        // wind direction in degrees (0=left→right)
    tile-size: int,          // particle cluster edge length in pixels (>=1)
    max-rotation-deg: float, // max particle rotation in degrees (0-360)
    speed: float,            // travel distance as a multiple of the frame diagonal
    seed: int,               // random seed (deterministic)
}

export struct PageFlipDetail {
    duration: int,          // milliseconds
    position: int,          // PageFlipPosition enum as int (0=Start, 1=End)
    corner: int,            // PageFlipCorner enum as int (0=BottomRight, 1=BottomLeft, 2=TopRight, 3=TopLeft)
    direction: int,         // PageFlipDirection enum as int (0=Forward, 1=Backward, 2=RoundTrip)
    axis: int,              // PageFlipAxis enum as int (0=Horizontal, 1=Vertical)
    shadow: bool,           // Whether to render shadow/highlight gradients
    flip-extent: float,     // How far the page flips (0.0–1.0, 1.0 = full flip)
    keep-base: bool,        // Whether to keep original image as base layer (peel/tear effect)
}

export struct LightingDetail {
    color-r: int,           // Light color R (0-255)
    color-g: int,           // Light color G (0-255)
    color-b: int,           // Light color B (0-255)
    brightness: float,      // Light brightness (default 1450.0)
    angle-deg: float,       // Cone angle in degrees (1.0-180.0)
    penumbra: float,        // Edge softness (0.0-1.0)
    decay: float,           // Distance decay exponent (0.0-10.0)
    max-distance: float,    // Maximum light distance (1.0-100.0)
    direction: int,         // LightingDirection enum as int (0=Down, 1=Up, 2=Left, 3=Right)
    pos-x: float,           // Light position X (-1.0-2.0)
    pos-y: float,           // Light position Y (-1.0-2.0)
    rope-length: float,     // Rope length for pendulum (0.0-1.0)
    gravity: float,         // Gravity strength
    swing: float,           // Swing amplitude (0.0-1.0)
    damping: float,         // Pendulum damping (0.0-1.0)
    ambient: float,         // Ambient light level (0.0-1.0)
    scene: int,             // LightingScene enum as int (0=Vertical, 1=Horizontal)
}

export struct SplitDetail {
    position: int,       // EffectPosition enum as int (0=Start, 1=End)
    duration: int,       // milliseconds
    direction: int,      // SplitDirection enum as int (0=Horizontal, 1=Vertical)
    split-position: float, // 0.0-1.0
    shadow: float,       // 0.0-1.0
    shadow-width: float, // 0.0-100.0
    easing: int,         // EasingFunction enum as int
}

export struct Live2dDetail {
    model-path: string,
    motion-index: int,
    expression-index: int,
    model-view-fill: float,
    background-r: int,
    background-g: int,
    background-b: int,
    background-a: int,
}

// ==================== Subtitle Filters ====================

export struct FontSizeDetail {
    font-size: int,
}

export struct PaddingDetail {
    padding: int,
}

export struct MarginVerticalDetail {
    margin: int,
}

export struct MarginHorizontalDetail {
    margin: int,
}

export struct OutlineWidthDetail {
    width: int,
}

export struct BorderRadiusDetail {
    radius: int,
}

export struct PrimaryColorDetail {
    r: int,
    g: int,
    b: int,
    a: int,
}

export struct OutlineColorDetail {
    r: int,
    g: int,
    b: int,
    a: int,
}

export struct BackgroundColorDetail {
    r: int,
    g: int,
    b: int,
    a: int,
}

export struct FontPathDetail {
    font-family: string,
    font-path: string,
    font-style: string,
}

export struct TextAlignmentDetail {
    alignment: int,  // 0=Left, 1=Center, 2=Right
}

export struct SubtitleStyle {
    font-path: FontPathDetail,
    font-size: FontSizeDetail,
    padding: PaddingDetail,
    margin-vertical: MarginVerticalDetail,
    margin-horizontal: MarginHorizontalDetail,
    outline-width: OutlineWidthDetail,
    border-radius: BorderRadiusDetail,
    primary-color: PrimaryColorDetail,
    outline-color: OutlineColorDetail,
    background-color: BackgroundColorDetail,
    text-alignment: TextAlignmentDetail,
}

export struct PresetSubtitleStyle {
    name: string,
    style: SubtitleStyle,
}

export global VEFilter {
    in-out property <bool> is-in-edit-mode;
    // 预览编辑状态开关（临时，不持久化；切换滤镜后重置为启用，方便在编辑模式下观察最终渲染效果）
    in-out property <bool> preview-edit-mode: true;
    in-out property <int> selected-filter-index: -1;
    in-out property <FilterType> selected-filter-type; // 用于popup action 和 switch。UI界面逻辑不要使用这个变量
    in-out property <SegmentFilter> selected-filter;
    in-out property <[FilterEntry]> video-filters: [];
    in-out property <[FilterEntry]> audio-filters: [];
    in-out property <[FilterEntry]> subtitle-filters: [];
    in-out property <[FilterEntry]> image-filters: [];

    in-out property <[PresetFilter]> video-preset-filters: [];
    in-out property <[PresetFilter]> audio-preset-filters: [];
    in-out property <[PresetFilter]> subtitle-preset-filters: [];
    in-out property <[PresetFilter]> image-preset-filters: [];

    // 复制滤镜是缓存的滤镜，用于后续粘贴
    in-out property <SegmentFilter> cache-copied-filter;

    // 用于创建预设滤镜时，临时存储选中的滤镜
    in-out property <[PresetFilter]> cache-preset-filters: [];

    in-out property <int> right-panel-selected-index;
    in-out property <SubtitleStyle> subtitle-style;
    in-out property <bool> is-show-preset-subtitle-style-new-lineinput;
    in-out property <bool> is-show-preset-subtitle-style-panel;
    in-out property <[PresetSubtitleStyle]> preset-subtitle-styles: [];

    in-out property <bool> toggle-keyframe-flag;

    // Text highlight pick color mode - when true, clicking preview picks background color
    in-out property <bool> text-highlight-pick-color-mode;
    in-out property <bool> chroma-key-pick-color-mode;

    in-out property <bool> preset-filter-enter-edit-mode-flag;
    in-out property <int> preset-filter-enter-edit-mode-index;

    // 拖拽滤镜列表条目改变位置
    in-out property <bool> filter-list-is-dragging: false;
    in-out property <int> drag-filter-index: -1;
    in-out property <int> drag-filter-target-index: -1;

    // 拖拽预设滤镜列表条目改变位置
    in-out property <bool> preset-filter-list-is-dragging: false;
    in-out property <int> drag-preset-filter-index: -1;
    in-out property <int> drag-preset-filter-target-index: -1;

    // Scale a pixel value from base 1080p to target resolution
    // Same as Rust's scale_pixel_for_height function
    // Parameters: pixel-value (1080p base), target-height (current resolution height)
    // Returns: scaled pixel value for display
    pure callback scale-pixel-for-resolution(pixel-value: int, target-height: int) -> int;

    callback show-preset-subtitle-style-panel();
    callback show-preset-subtitle-style-new-lineinput();
    callback create-preset-subtitle-style(name: string);
    callback remove-preset-subtitle-style(index: int);
    callback apply-preset-subtitle-style(track-index: int, style: SubtitleStyle);

    callback up-filter(index: int);
    callback down-filter(index: int);
    callback move-to-top-filter(index: int);
    callback move-to-bottom-filter(index: int);
    callback move-filter-by-drag(from-index: int, to-index: int);
    callback move-preset-filter-by-drag(filter-type-index: int, from-index: int, to-index: int);
    callback remove-filter(index: int);
    callback toggle-filter(index: int);
