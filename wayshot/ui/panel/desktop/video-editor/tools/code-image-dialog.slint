import {
    Store,
    Logic,
    Theme,
    Icons,
    Util,
    CodeImageConfig,
    FontEntry,
} from "../../../def.slint";
import {
    Label,
    MovingDialog,
    TxtEdit,
    Select,
    ElevatedBtn,
    ConfirmBtn,
    LineInput,
    SettingDetailInnerVbox,
    SettingDetailLabel,
    SettingDetailSwitch,
    NoDataImg,
} from "../../../../base/widgets.slint";
import { ScrollView } from "std-widgets.slint";

export component CodeImageDialog inherits MovingDialog {
    title: Logic.tr("Code Image");
    icon: Icons.code-light;
    header-width: Theme.moving-dialog-width;
    body-height: root.header-width * Theme.golden-ratio;
    head-y: self.height * 0.1;
    enable-resize: true;

    private property <image> preview-image;
    private property <int> font-id;
    private property <bool> has-preview: preview-image.width > 0;
    private property <CodeImageConfig> config <=> Store.video-editor-code-image-config;

    private property <[string]> language-options: [
        "Rust",
        "Python",
        "JavaScript",
        "Go",
        "C",
        "Cpp",
        "Java",
        "Ruby",
        "PHP",
        "HTML",
        "CSS",
        "JSON",
        "YAML",
        "Markdown",
        "Shell",
        "SQL",
        "Lua",
        "Scala",
    ];

    private property <[string]> syntax-theme-options: [
        "InspiredGitHub",
        "Solarized (dark)",
        "Solarized (light)",
        "base16-eighties.dark",
        "base16-mocha.dark",
        "base16-ocean.dark",
        "base16-ocean.light",
    ];

    private property <int> color-picker-id;
    private property <bool> color-picker-confirmed-flag: Store.video-editor-color-picker-confirmed-flag;

    changed color-picker-confirmed-flag => {
        if (color-picker-id == Store.video-editor-color-picker-id) {
            root.config.bg-color = Util.color-picker-str(
                Store.video-editor-color-picker-color.red,
                Store.video-editor-color-picker-color.green,
                Store.video-editor-color-picker-color.blue,
                Store.video-editor-color-picker-color.alpha);
            Logic.video-editor-update-code-image-config(root.config);
        }
    }

    HorizontalLayout {
        padding: Theme.padding * 2;
        spacing: Theme.spacing * 2;

        private property <length> inner-width: self.width - self.spacing * 2 - self.padding * 2;

        VerticalLayout {
            width: parent.inner-width * 0.45;
            spacing: Theme.spacing * 3;

            Rectangle {
                background: Theme.secondary-background;
                border-radius: Theme.border-radius;
                clip: true;

                if !root.has-preview: NoDataImg {
                    image: Icons.preview-light;
                    text: Logic.tr("No Preview");
                    colorize: Theme.primary-text-color;
                }

                if root.has-preview: VerticalLayout {
                    width: parent.width - Theme.padding * 4;
                    height: parent.height - Theme.padding * 4;

                    flick := Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: img.width;
                        viewport-height: img.height;

                        img := Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.preview-image;
                            image-fit: contain;

                            TouchArea {
                                scroll-event(event) => {
                                    let scale-factor = event.delta-y < 0 ? 1.1 : 0.9;
                                    let pos-x = self.mouse-x / self.width;
                                    let pos-y = self.mouse-y / self.height;
                                    let offset-x = self.mouse-x - abs(flick.viewport-x);
                                    let offset-y = self.mouse-y - abs(flick.viewport-y);

                                    img.width = max(flick.width, img.width * scale-factor);
                                    img.height = max(flick.height, img.height * scale-factor);

                                    flick.viewport-x = -(img.width * pos-x - offset-x);
                                    flick.viewport-y = -(img.height * pos-y - offset-y);

                                    accept
                                }
                            }
                        }
                    }
                }

                if root.has-preview: Rectangle {
                    x: parent.width - self.width - Theme.padding * 2;
                    y: Theme.padding * 2;
                    background: Theme.thirdly-background;
                    width: size-lb.preferred-width + Theme.padding * 8;
                    height: size-lb.preferred-height + Theme.padding * 4;
                    border-radius: Theme.border-radius * 2;
                    border-width: Theme.default-border-width;
                    border-color: Theme.base-border-color;

                    size-lb := Label {
                        text: root.preview-image.width + " X " + root.preview-image.height;
                    }
                }
            }

            ConfirmBtn {
                text: Logic.tr("Add to Playlist");
                icon: Icons.add-light;
                auto-size-vpadding: Theme.padding * 2;

                clicked => {
                    if root.has-preview {
                        Logic.video-editor-add-code-image-to-playlist(root.preview-image);
                    }
                }
            }
        }

        VerticalLayout {
            width: parent.inner-width * 0.30;
            spacing: Theme.spacing * 3;

            SettingDetailInnerVbox {
                SettingDetailLabel {
                    text: Logic.tr("Language");
                }

                Select {
                    values: root.language-options;
                    current-value: root.config.language;
                    gain-focus-when-clicked: false;

                    selected(index, value) => {
                        root.config.language = value;
                        Logic.video-editor-update-code-image-config(root.config);
                    }
                }
            }

            TxtEdit {
                placeholder: Logic.tr("Enter your code here...");
                text: root.config.code;

                edited(new-text) => {
                    root.config.code = new-text;
                    Logic.video-editor-update-code-image-config(root.config);
                }
            }

            ConfirmBtn {
                text: Logic.tr("Generate");
                icon: Icons.code-light;
                auto-size-vpadding: Theme.padding * 2;

                clicked => {
                    if !root.config.code.is-empty {
                        root.preview-image = Logic.video-editor-generate-code-image(root.config);
                    }
                }
            }
        }

        Flickable {
            interactive: false;
            width: parent.inner-width * 0.25;
            viewport-height: right-vbox.preferred-height;

            right-vbox := VerticalLayout {
                x: 0;
                y: 0;
                width: parent.width;
                spacing: Theme.spacing * 4;

                SettingDetailInnerVbox {
                    SettingDetailLabel {
                        text: Logic.tr("Syntax Theme");
                        tip: Logic.tr("Color scheme for code highlighting");
                    }

                    Select {
                        width: right-vbox.width - right-vbox.padding * 2;
                        values: root.syntax-theme-options;
                        current-value: root.config.syntax-theme;
                        gain-focus-when-clicked: false;

                        selected(index, value) => {
                            root.config.syntax-theme = value;
                            Logic.video-editor-update-code-image-config(root.config);
                        }
                    }
                }

                SettingDetailInnerVbox {
                    private property <FontEntry> selected-font <=> Store.selected-font-entry;
                    private property <bool> font-exist: Logic.file-exist(root.config.ascii-font-path);
                    private property <int> inner-font-id;

                    changed selected-font => {
                        if (root.font-id == self.inner-font-id) {
                            ascii-font-li.text = selected-font.family;
                            root.config.ascii-font-path = selected-font.path;
                            root.config.ascii-font-family = selected-font.family;
                            root.config.ascii-font-style = selected-font.style;
                            Logic.video-editor-update-code-image-config(root.config);
                        }
                    }

                    SettingDetailLabel {
                        text: Logic.tr("ASCII Font");
                    }

                    ascii-font-li := LineInput {
                        border-color: font-exist ? (Theme.is-dark ? Theme.base-border-color.brighter(20%) : Theme.base-border-color.darker(10%)) : Theme.danger-color;
                        read-only: true;
                        icon: Icons.font-light;
                        is-show-icon: true;
                        icon-size: Theme.icon-size * Theme.golden-ratio;
                        text: root.config.ascii-font-family;

                        changed has-focus => {
                            if (!self.has-focus) {
                                Store.video-editor-focus-flag = !Store.video-editor-focus-flag;
                            }
                        }

                        clicked => {
                            root.font-id += 1;
                            parent.inner-font-id = root.font-id;
                            Store.is-show-font-dialog = true;
                        }
                    }
                }

                SettingDetailInnerVbox {
                    private property <FontEntry> selected-font <=> Store.selected-font-entry;
                    private property <bool> font-exist: Logic.file-exist(root.config.non-ascii-font-path);
                    private property <int> inner-font-id;

                    changed selected-font => {
                        if (root.font-id == self.inner-font-id) {
                            non-ascii-font-li.text = selected-font.family;
                            root.config.non-ascii-font-path = selected-font.path;
                            root.config.non-ascii-font-family = selected-font.family;
                            root.config.non-ascii-font-style = selected-font.style;
                            Logic.video-editor-update-code-image-config(root.config);
                        }
                    }

                    SettingDetailLabel {
                        text: Logic.tr("Non ASCII Font");
                    }

                    non-ascii-font-li := LineInput {
                        border-color: font-exist ? (Theme.is-dark ? Theme.base-border-color.brighter(20%) : Theme.base-border-color.darker(10%)) : Theme.danger-color;
                        read-only: true;
                        icon: Icons.font-light;
                        is-show-icon: true;
                        icon-size: Theme.icon-size * Theme.golden-ratio;
                        text: root.config.non-ascii-font-family;

                        changed has-focus => {
                            if (!self.has-focus) {
                                Store.video-editor-focus-flag = !Store.video-editor-focus-flag;
                            }
                        }

                        clicked => {
                            root.font-id += 1;
                            parent.inner-font-id = root.font-id;
                            Store.is-show-font-dialog = true;
                        }
                    }
                }

                SettingDetailInnerVbox {
                    SettingDetailLabel {
                        text: Logic.tr("Font Size");
                    }

                    LineInput {
                        input-type: InputType.number;
                        text: root.config.font-size;

                        edited => {
                            root.config.font-size = self.text.to-float();
                        }

                        accepted => {
                            root.config.font-size = self.text.to-float();
                            Logic.video-editor-update-code-image-config(root.config);
                        }
                    }
                }

                SettingDetailInnerVbox {
                    SettingDetailLabel {
                        text: Logic.tr("Line Height Ratio");
                        tip: Logic.tr("1.5 = 1.5x font size spacing");
                    }

                    LineInput {
                        input-type: InputType.decimal;
                        text: root.config.line-height-ratio.to-fixed(1);

                        edited => {
                            root.config.line-height-ratio = self.text.to-float();
                        }

                        accepted => {
                            root.config.line-height-ratio = self.text.to-float();
                            Logic.video-editor-update-code-image-config(root.config);
                        }
                    }
                }

                SettingDetailInnerVbox {
                    SettingDetailLabel {
                        text: Logic.tr("Padding");
                    }

                    LineInput {
                        input-type: InputType.number;
                        text: root.config.padding.to-fixed(0);

                        edited => {
                            root.config.padding = self.text.to-float();
                        }

                        accepted => {
                            root.config.padding = self.text.to-float();
                            Logic.video-editor-update-code-image-config(root.config);
                        }
                    }
                }

                SettingDetailInnerVbox {
                    SettingDetailLabel {
                        text: Logic.tr("Scale");
                        tip: Logic.tr("Resolution multiplier for high-DPI output");
                    }

                    LineInput {
                        input-type: InputType.decimal;
                        text: root.config.scale.to-fixed(1);

                        edited => {
                            root.config.scale = self.text.to-float();
                        }

                        accepted => {
                            root.config.scale = self.text.to-float();
                            Logic.video-editor-update-code-image-config(root.config);
                        }
                    }
                }

                SettingDetailInnerVbox {
                    SettingDetailLabel {
                        text: Logic.tr("Background");
                        tip: Logic.tr("Override default theme background (Take effect when terminal-style disabled)");
                    }

                    LineInput {
                        read-only: true;
                        is-show-icon: true;
                        is-show-color-block: true;
                        icon: Icons.color-picker-light;
                        color-block-color: Util.color-picker-hex-color(self.text);
                        text: root.config.bg-color.is-empty ? "#000000" : root.config.bg-color;

                        clicked => {
                            Store.video-editor-color-picker-id = Store.video-editor-color-picker-id + 1;
                            root.color-picker-id = Store.video-editor-color-picker-id;
                            Store.video-editor-color-picker-color = root.config.bg-color.is-empty ? #000000 : Util.color-picker-hex-color(root.config.bg-color);
                            Store.video-editor-color-picker-toggle-flag = !Store.video-editor-color-picker-toggle-flag;
                        }
                    }
                }

                SettingDetailSwitch {
                    icon: Icons.number-light;
                    text: self.checked ? Logic.tr("Show line numbers") : Logic.tr("Hide line numbers");
                    checked: root.config.line-numbers;
                    gain-focus-when-clicked: false;

                    toggled => {
                        root.config.line-numbers = !root.config.line-numbers;
                        Logic.video-editor-update-code-image-config(root.config);
                    }
                }

                SettingDetailSwitch {
                    icon: Icons.terminal-light;
                    text: Logic.tr("Terminal Style");
                    checked: root.config.enable-terminal;
                    gain-focus-when-clicked: false;

                    toggled => {
                        root.config.enable-terminal = !root.config.enable-terminal;
                        Logic.video-editor-update-code-image-config(root.config);
                    }
                }

                if root.config.enable-terminal: VerticalLayout {
                    spacing: Theme.spacing * 4;

                    SettingDetailInnerVbox {
                        SettingDetailLabel {
                            text: Logic.tr("Style");
                            tip: Logic.tr("Window decoration style");
                        }

                        Select {
                            private property <[string]> terminal-style-options: ["MacOS", "MacOSDark", "Windows", "WindowsDark", "Gnome", "ITerm"];

                            values: terminal-style-options;
                            current-value: root.config.terminal-style;
                            gain-focus-when-clicked: false;

                            selected(index, value) => {
                                root.config.terminal-style = value;
                                Logic.video-editor-update-code-image-config(root.config);
                            }
                        }
                    }

                    SettingDetailInnerVbox {
                        SettingDetailLabel {
                            text: Logic.tr("Window Title");
                        }

                        LineInput {
                            text: root.config.terminal-title;
                            placeholder-text: Logic.tr("Terminal");
                            border-color: self.text != root.config.terminal-title ? Theme.danger-color : self.default-border-color;

                            accepted => {
                                root.config.terminal-title = self.text;
                                Logic.video-editor-update-code-image-config(root.config);
                            }
                        }
                    }
                }
            }
        }
    }
}
