export enum InkStyle {
    InkOnPaper,    // White background + black ink (traditional)
    PaperOnInk,    // Black background + white ink (inverted)
}

export enum AnimationType {
    Grid,
    MovingGrid,
    Glitch,
    NoiseFlow,
    Bokeh,
    MatrixRain,
    Fluid,
    Kaleidoscope,
    LightEffects,
    InkDissipation,
    ParticleLife,
    ParticleNetwork,
    FlowField,
    Shape,
    BlackHole,
    Galaxy,
    Triangle,
    Wave,
    CrossLine,
}

export struct GridAnimConfig {
    rows: int,
    cols: int,
    amplitude: float,
    node-amplitude: float,
    frequency: float,
    node-radius: int,
    line-color-r: int,
    line-color-g: int,
    line-color-b: int,
    line-color-a: int,
    line-width: float,
    bg-color-r: int,
    bg-color-g: int,
    bg-color-b: int,
    node-color-r: int,
    node-color-g: int,
    node-color-b: int,
    node-color-a: int,
}

export struct MovingGridAnimConfig {
    rows: int,
    cols: int,
    speed: float,
    direction: string,  // "Up", "Down"
    line-color-r: int,
    line-color-g: int,
    line-color-b: int,
    line-color-a: int,
    line-width: float,
    bg-color-r: int,
    bg-color-g: int,
    bg-color-b: int,
    supersample: int,
}

export struct GlitchAnimConfig {
    intensity: float,
    scan-lines-enabled: bool,
    scan-line-spacing: int,
    rgb-split-enabled: bool,
    rgb-split-offset: int,
    block-shift-enabled: bool,
    block-shift-max-offset: int,
    noise-enabled: bool,
    animation-speed: float,
    bg-color-r: int,
    bg-color-g: int,
    bg-color-b: int,
}

export struct NoiseFlowAnimConfig {
    noise-scale: float,
    animation-speed: float,
    // Color palette as arrays: r, g, b, a
    palette-r: [int],
    palette-g: [int],
    palette-b: [int],
    palette-a: [int],
    bg-color-r: int,
    bg-color-g: int,
    bg-color-b: int,
    flow-direction: string,  // "Right", "Down", "Diagonal"
}

export struct BokehAnimConfig {
    spot-count: int,
    min-size: float,
    max-size: float,
    blur-radius: float,
    animation-speed: float,
    hexagonal-enabled: bool,
    // Colors as arrays: r, g, b, a
    colors-r: [int],
    colors-g: [int],
    colors-b: [int],
    colors-a: [int],
    bg-color-r: int,
    bg-color-g: int,
    bg-color-b: int,
}

export struct MatrixRainAnimConfig {
    columns: int,
    cell-size: int,
    min-speed: float,
    max-speed: float,
    trail-length: int,
    fade-speed: float,
    color-r: int,
    color-g: int,
    color-b: int,
    bg-color-r: int,
    bg-color-g: int,
    bg-color-b: int,
    glow-intensity: float,
    char-change-prob: float,
    flicker-prob: float,
    particle-density: int,
}

export struct FluidAnimConfig {
    resolution-divisor: int,
    viscosity: float,
    diffusion: float,
    force-source: string,  // "Random", "Circular", "Vortices"
    num-sources: int,
    steps-per-frame: int,
    color-injection: bool,
    // Colors as arrays: r, g, b
    colors-r: [int],
    colors-g: [int],
    colors-b: [int],
    bg-color-r: int,
    bg-color-g: int,
    bg-color-b: int,
}

export struct KaleidoscopeAnimConfig {
    segments: int,
    rotation-speed: float,
    center-x: float,
    center-y: float,
    scale: float,
    complexity: int,
    // Colors as arrays: r, g, b
    colors-r: [int],
    colors-g: [int],
    colors-b: [int],
    bg-color-r: int,
    bg-color-g: int,
    bg-color-b: int,
}

export struct LightEffectsAnimConfig {
    flare-count: int,
    min-size: float,
    max-size: float,
    movement-speed: float,
    elliptical-enabled: bool,
    bands-enabled: bool,
    // Colors as arrays: r, g, b, a
