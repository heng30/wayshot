export struct BackgroundAnimationConfig {
    id: string,
    animation-type: AnimationType,
    width: int,
    height: int,
    fps: int,
    duration: int,  // seconds
    save-dir: string,
    grid: GridAnimConfig,
    moving-grid: MovingGridAnimConfig,
    glitch: GlitchAnimConfig,
    noise-flow: NoiseFlowAnimConfig,
    bokeh: BokehAnimConfig,
    matrix-rain: MatrixRainAnimConfig,
    fluid: FluidAnimConfig,
    kaleidoscope: KaleidoscopeAnimConfig,
    light-effects: LightEffectsAnimConfig,
    ink-dissipation: InkDissipationAnimConfig,
    particle-life: ParticleLifeAnimConfig,
    particle-network: ParticleNetworkAnimConfig,
    flow-field: FlowFieldAnimConfig,
    shape: ShapeAnimConfig,
    black-hole: BlackHoleAnimConfig,
    galaxy: GalaxyAnimConfig,
    triangle: TriangleAnimConfig,
    wave: WaveAnimConfig,
    cross-line: CrossLineAnimConfig,
}
