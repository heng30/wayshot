export component OnlineSearch inherits Rectangle {
    private property <length> select-width: Store.is-cn ? Theme.default-font-size * 6 : Theme.default-font-size * 8;

    private property <int> selected-index: Store.video-editor-left-panel-selected-index;
    changed selected-index => {
        if selected-index == 2 {
            search-bar.focus();
            try-show-setting();
        }
    }

    function try-show-setting() {
        if Store.video-editor-online-search-image-media-type == OnlineSearchImageMediaType.Image {
            if !Logic.video-editor-online-search-image-config-is-valid() {
                Store.video-editor-is-show-online-search-image-setting-dialog = true;
            }
        } else {
            if !Logic.video-editor-online-search-audio-config-is-valid() {
                Store.video-editor-is-show-online-search-audio-setting-dialog = true;
            }
        }
    }

    VerticalLayout {
        padding: Theme.padding * 2;
        spacing: Theme.spacing * 2;

        private property <length> header-height: Theme.icon-size + Theme.padding * 2;

        if Store.video-editor-online-search-image-media-type == OnlineSearchImageMediaType.Image: ImageHeaderBar {
            height: header-height;
            select-width: root.select-width;
        }

        if Store.video-editor-online-search-image-media-type == OnlineSearchImageMediaType.Audio: AudioHeaderBar {
            height: header-height;
            select-width: root.select-width;
        }

        HorizontalLayout {
            spacing: Theme.spacing;

            Select {
                width: Store.is-cn ? Theme.default-font-size * 5 : Theme.default-font-size * 7;
                values: [Logic.tr("Image"), Logic.tr("Audio")];
                current-value: Store.video-editor-online-search-image-media-type == OnlineSearchImageMediaType.Image ? self.values[0] : self.values[1];
                gain-focus-when-clicked: false;
                indicator-left-padding: 0;

                selected(idx, value) => {
                    Store.video-editor-online-search-image-media-type = idx == 0 ? OnlineSearchImageMediaType.Image : OnlineSearchImageMediaType.Audio;
                    try-show-setting();
                }
            }

            search-bar := Search {
                gain-focus-when-clicked: false;

                private property <bool> flag: Store.video-editor-online-search-image-focus-flag;
                changed flag => {
                    self.focus();
                }

                search(text) => {
                    if !text.is-empty {
                        if Store.video-editor-online-search-image-media-type == OnlineSearchImageMediaType.Image {
                            Store.video-editor-online-search-image-param.keyword = text;
                            Logic.video-editor-online-search-image(Store.video-editor-online-search-image-param);
                        } else {
                            Store.video-editor-online-search-audio-param.keyword = text;
                            Logic.video-editor-online-search-audio(Store.video-editor-online-search-audio-param);
                        }
                    }
                    self.focus();
                }

                key-pressed(event) => {
                    if event.text == Key.Escape {
                        Store.video-editor-focus-flag = !Store.video-editor-focus-flag;

                        if Store.video-editor-online-search-image-media-type == OnlineSearchImageMediaType.Image && Store.video-editor-online-search-image-is-searching {
                            Logic.video-editor-online-search-image-cancel();
                        }
                        if Store.video-editor-online-search-image-media-type == OnlineSearchImageMediaType.Audio && Store.video-editor-online-search-audio-is-searching {
                            Logic.video-editor-online-search-audio-cancel();
                        }
                    }
                }
            }
        }

        if Store.video-editor-online-search-image-media-type == OnlineSearchImageMediaType.Image: ImageGrid { }
        if Store.video-editor-online-search-image-media-type == OnlineSearchImageMediaType.Audio: AudioGrid { }
    }
}

export component OnlineSearchImageSettingDialog inherits MovingDialog {
    title: Logic.tr("Online Image Search Settings");
    icon: Icons.setting-light;
    header-width: Theme.moving-dialog-min-width;
    head-y: self.height * 0.2;

    SettingDetailInner {
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Download Directory");
            }

            LineInput {
                text <=> Store.video-editor-online-search-image-setting.download-dir;
                placeholder-text: Logic.tr("Select download directory");
                icon: Icons.folder-open-light;
                read-only: true;
                is-show-icon: true;
                border-color: Logic.dir-exist(self.text) ? self.default-border-color : Theme.danger-color;

                clicked => {
                    Logic.video-editor-online-search-image-choose-save-dir();
                }
            }
        }

        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Search Limits Per Source");
            }

            LineInput {
                input-type: number;
                placeholder-text: "25";
                text: Store.video-editor-online-search-image-setting.search-limits;
                border-color: self.text == Store.video-editor-online-search-image-setting.search-limits ? self.default-border-color : Theme.danger-color;

                accepted => {
                    let val = self.text.to-float().round().max(1);
                    self.text = val;
                    Store.video-editor-online-search-image-setting.search-limits = val;
                    Logic.video-editor-online-search-image-update-config(Store.video-editor-online-search-image-setting);
                }
            }
        }

        SettingDetailInnerVbox {
            HorizontalLayout {
                spacing: Theme.spacing;

                proxy-select := Select {
                    gain-focus-when-clicked: false;
                    width: Theme.default-font-size * 8;
                    values: ["Http", "Socks5"];
                    current-value: {
                        let setting = Store.video-editor-online-search-image-setting;
                        if setting.http-proxy-url.is-empty && setting.socks5-proxy-url.is-empty {
                            self.values[0]
                        } else if setting.http-proxy-url.is-empty {
                            self.values[1]
                        } else {
                            self.values[0]
                        }
                    };
                }

                if proxy-select.current-value == "Http": HorizontalLayout {
                    spacing: Theme.spacing;

                    LineInput {
                        placeholder-text: "http://127.0.0.1:8080";
                        text: Store.video-editor-online-search-image-setting.http-proxy-url;
                        border-color: self.text != Store.video-editor-online-search-image-setting.http-proxy-url ? Theme.danger-color : self.default-border-color;

                        accepted => {
                            Store.video-editor-online-search-image-setting.http-proxy-url = self.text;
                            Logic.video-editor-online-search-image-update-config(Store.video-editor-online-search-image-setting);
                        }
                    }
                }

                if proxy-select.current-value == "Socks5": HorizontalLayout {
                    spacing: Theme.spacing;

                    LineInput {
                        placeholder-text: "socks5://127.0.0.1:1080";
                        text: Store.video-editor-online-search-image-setting.socks5-proxy-url;
                        border-color: self.text != Store.video-editor-online-search-image-setting.socks5-proxy-url ? Theme.danger-color : self.default-border-color;

                        accepted => {
                            Store.video-editor-online-search-image-setting.socks5-proxy-url = self.text;
                            Logic.video-editor-online-search-image-update-config(Store.video-editor-online-search-image-setting);
                        }
                    }
                }
            }
        }

        SettingDetailInnerVbox {
            HorizontalLayout {
                alignment: space-between;
                padding-right: Theme.padding * 2;

                SettingDetailLabel {
                    text: Logic.tr("Search Sources");
                }

                HorizontalLayout {
                    spacing: Theme.spacing * 4;

                    IconBtn {
                        is-show-tip: true;
                        icon: Icons.select-all-light;
                        tip: Logic.tr("select all");

                        clicked => {
                            Logic.video-editor-online-search-image-select-all-sources();
                        }
                    }

                    IconBtn {
                        is-show-tip: true;
                        icon: Icons.deselect-all-light;
                        tip: Logic.tr("deselect all");

                        clicked => {
                            Logic.video-editor-online-search-image-deselect-all-sources();
                        }
                    }

                    IconBtn {
                        icon: Icons.refresh-light;
                        icon-size: Theme.icon-size * 0.7;
                        is-show-tip: true;
                        tip: Logic.tr("refresh");

                        clicked => {
                            Logic.video-editor-online-search-image-refresh-sources-status();
                        }
                    }
                }
            }

            Rectangle {
                height: Theme.icon-size * 15;
                border-color: Theme.base-border-color;
                border-width: Theme.default-border-width;

                ScrollView {
                    VerticalLayout {
                        padding: Theme.default-border-width;

                        for source[index] in Store.video-editor-online-search-image-setting.sources: SourceEntry {
                            index: index;
                            source: source;

                            enabled-changed(source) => {
                                Logic.video-editor-online-search-image-update-source(index, source);
                            }
                            proxy-type-changed(source) => {
                                Logic.video-editor-online-search-image-update-source(index, source);
                            }
                        }
                    }
                }
            }
        }
    }
}

component AudioSourceEntry inherits Rectangle {
    in property <int> index;
    in-out property <OnlineSearchAudioSourceEntry> source;

    callback enabled-changed(source: OnlineSearchAudioSourceEntry);
    callback proxy-type-changed(value: OnlineSearchAudioSourceEntry);

    height: hbox.preferred-height;
    background: mod(index, 2) == 0 ? Theme.table-item-first : Theme.table-item-second;

    hbox := HorizontalLayout {
        padding: Theme.padding * 2;
        padding-top: Theme.padding;
        padding-bottom: Theme.padding;
        spacing: Theme.spacing * 2;
        alignment: LayoutAlignment.space-between;

        VerticalLayout {
            alignment: center;

            CheckBtn {
                text: source.name;
                checked: source.enabled;

                toggled => {
                    source.enabled = !source.enabled;
                    root.enabled-changed(source);
                }
            }
        }

        HorizontalLayout {
            proxy-select := Select {
                width: Theme.default-font-size * 6;
                values: ["None", "Http", "Socks5"];
                current-value: source.proxy-type;
                gain-focus-when-clicked: false;
                is-show-indicator: false;
                background: root.background;
                indicator-left-padding: 0;

                selected(idx, value) => {
                    source.proxy-type = value;
                    root.proxy-type-changed(source);
                }
            }

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: Theme.default-font-size;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: source.is-testing ? Theme.warning-color : (source.can-access ? Theme.success-color : Theme.danger-color);

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Logic.video-editor-online-search-audio-refresh-source-status(index);
                        }
                    }
                }
            }
        }
    }
}

export component OnlineSearchAudioSettingDialog inherits MovingDialog {
    title: Logic.tr("Online Audio Search Settings");
    icon: Icons.setting-light;
    header-width: Theme.moving-dialog-min-width;
    head-y: self.height * 0.2;

    SettingDetailInner {
        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Download Directory");
            }

            LineInput {
                text <=> Store.video-editor-online-search-audio-setting.download-dir;
                placeholder-text: Logic.tr("Select download directory");
                icon: Icons.folder-open-light;
                read-only: true;
                is-show-icon: true;
                border-color: Logic.dir-exist(self.text) ? self.default-border-color : Theme.danger-color;

                clicked => {
                    Logic.video-editor-online-search-audio-choose-save-dir();
                }
            }
        }

        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Search Limits Per Source");
            }

            LineInput {
                input-type: number;
                placeholder-text: "10";
                text: Store.video-editor-online-search-audio-setting.search-limits;
                border-color: self.text == Store.video-editor-online-search-audio-setting.search-limits ? self.default-border-color : Theme.danger-color;

                accepted => {
                    let val = self.text.to-float().round().max(1);
                    self.text = val;
                    Store.video-editor-online-search-audio-setting.search-limits = val;
                    Logic.video-editor-online-search-audio-update-config(Store.video-editor-online-search-audio-setting);
                }
            }
        }

        SettingDetailInnerVbox {
            SettingDetailLabel {
                text: Logic.tr("Proxy") + " (" + Logic.tr("Shared with Image Search") + ")";
            }

            HorizontalLayout {
                spacing: Theme.spacing;

                proxy-select := Select {
                    gain-focus-when-clicked: false;
                    width: Theme.default-font-size * 8;
                    values: ["Http", "Socks5"];
                    current-value: {
                        let setting = Store.video-editor-online-search-image-setting;
                        if setting.http-proxy-url.is-empty && setting.socks5-proxy-url.is-empty {
                            self.values[0]
                        } else if setting.http-proxy-url.is-empty {
                            self.values[1]
                        } else {
                            self.values[0]
                        }
                    };
                }

                if proxy-select.current-value == "Http": HorizontalLayout {
                    spacing: Theme.spacing;

                    LineInput {
                        placeholder-text: "http://127.0.0.1:8080";
                        text: Store.video-editor-online-search-image-setting.http-proxy-url;
                        border-color: self.text != Store.video-editor-online-search-image-setting.http-proxy-url ? Theme.danger-color : self.default-border-color;

                        accepted => {
                            Store.video-editor-online-search-image-setting.http-proxy-url = self.text;
                            Logic.video-editor-online-search-image-update-config(Store.video-editor-online-search-image-setting);
                        }
                    }
                }

                if proxy-select.current-value == "Socks5": HorizontalLayout {
                    spacing: Theme.spacing;

                    LineInput {
                        placeholder-text: "socks5://127.0.0.1:1080";
                        text: Store.video-editor-online-search-image-setting.socks5-proxy-url;
                        border-color: self.text != Store.video-editor-online-search-image-setting.socks5-proxy-url ? Theme.danger-color : self.default-border-color;

                        accepted => {
                            Store.video-editor-online-search-image-setting.socks5-proxy-url = self.text;
                            Logic.video-editor-online-search-image-update-config(Store.video-editor-online-search-image-setting);
                        }
                    }
                }
            }
        }

        SettingDetailInnerVbox {
            HorizontalLayout {
                alignment: space-between;
                padding-right: Theme.padding * 2;

                SettingDetailLabel {
                    text: Logic.tr("Search Sources");
                }

                HorizontalLayout {
                    spacing: Theme.spacing * 4;

                    IconBtn {
                        is-show-tip: true;
                        icon: Icons.select-all-light;
                        tip: Logic.tr("select all");

                        clicked => {
                            Logic.video-editor-online-search-audio-select-all-sources();
                        }
                    }

                    IconBtn {
                        is-show-tip: true;
                        icon: Icons.deselect-all-light;
                        tip: Logic.tr("deselect all");

                        clicked => {
                            Logic.video-editor-online-search-audio-deselect-all-sources();
                        }
                    }

                    IconBtn {
                        icon: Icons.refresh-light;
                        icon-size: Theme.icon-size * 0.7;
                        is-show-tip: true;
                        tip: Logic.tr("refresh");

                        clicked => {
                            Logic.video-editor-online-search-audio-refresh-sources-status();
                        }
                    }
                }
            }

            Rectangle {
                height: Theme.icon-size * 10;
                border-color: Theme.base-border-color;
                border-width: Theme.default-border-width;

                ScrollView {
                    VerticalLayout {
                        padding: Theme.default-border-width;

                        for source[index] in Store.video-editor-online-search-audio-setting.sources: AudioSourceEntry {
                            index: index;
                            source: source;

                            enabled-changed(source) => {
                                Logic.video-editor-online-search-audio-update-source(index, source);
                            }

                            proxy-type-changed(source) => {
                                Logic.video-editor-online-search-audio-update-source(index, source);
                            }
                        }
                    }
                }
            }
        }
    }
}
