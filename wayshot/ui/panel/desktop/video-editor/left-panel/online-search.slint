import {
    Theme,
    Store,
    Logic,
    Icons,
    OnlineSearchImageMediaType,
    OnlineSearchImageSetting,
    OnlineSearchImageSourceEntry,
    OnlineSearchImageResultItem,
    OnlineSearchAudioSetting,
    OnlineSearchAudioSourceEntry,
    OnlineSearchAudioResultItem,
    OnlineSearchAudioParam,
    MediaType,
} from "../../../def.slint";
import {
    Select,
    Search,
    IconBtn,
    CheckBtn,
    LineInput,
    Label,
    Loading,
    NoDataImg,
    MovingDialog,
    SettingDetailInner,
    SettingDetailInnerVbox,
    SettingDetailLabel,
    Skeleton,
    SkeletonType,
} from "../../../../base/widgets.slint";
import { ScrollView } from "std-widgets.slint";

component AudioThumbnailItem inherits Rectangle {
    in property <OnlineSearchAudioResultItem> item;
    in property <length> size: Theme.icon-size * 4;

    callback preview-audio();
    callback download-clicked();

    clip: true;
    width: size;
    height: size + Theme.default-font-size * 3.5;
    background: Theme.secondary-background;
    border-radius: Theme.border-radius;

    VerticalLayout {
        Rectangle {
            clip: true;
            width: parent.width;
            height: size;
            background: Theme.secondary-background;

            if item.thumbnail.width > 0: Image {
                width: parent.width;
                height: parent.height;
                image-fit: contain;
                source: item.thumbnail;

                TouchArea {
                    enabled: !item.is-downloading;
                    clicked => { root.preview-audio(); }
                }
            }

            if item.thumbnail.width == 0: Rectangle {
                width: parent.width;
                height: parent.height;
                background: Theme.secondary-background;

                Skeleton {
                    width: parent.width;
                    height: parent.height;
                    type: SkeletonType.Picture;
                }

                TouchArea {
                    enabled: !item.is-downloading;
                    clicked => { root.preview-audio(); }
                }
            }

            if item.duration != "": Rectangle {
                x: Theme.padding;
                y: parent.height - self.height - Theme.padding;
                width: dur-vbox.preferred-width;
                height: dur-vbox.preferred-height;
                background: Theme.thirdly-background;
                border-radius: Theme.border-radius;

                dur-vbox := HorizontalLayout {
                    padding: Theme.padding;

                    Label {
                        text: item.duration;
                        font-size: Theme.default-font-size - 4px;
                        color: Theme.invert-text-color;
                    }
                }
            }

            if item.is-downloading: Rectangle {
                width: parent.width;
                height: parent.height;
                background: Theme.secondary-background;
                opacity: Theme.golden-ratio;

                Loading {
                    width: parent.width;
                    height: parent.height;
                    icon-size: Theme.icon-size;
                    loading-text: Logic.tr("Downloading");
                }
            }

            if !item.is-downloading: IconBtn {
                x: parent.width - self.width - Theme.padding;
                y: parent.height - self.height - Theme.padding;
                width: Theme.icon-size * 1.33;
                height: self.width;
                icon: Icons.download-light;
                border-radius: self.width / 2;
                show-icon-hover-background: false;
                gain-focus-when-clicked: false;
                is-show-tip: true;
                tip: Logic.tr("download");
                colorize: self.has-hover ? Theme.light-text-color : Theme.invert-text-color;
                background: self.has-hover ? Theme.thirdly-brand-color : (item.is-downloaded ? Theme.success-color : Theme.thirdly-background);

                clicked => {
                    root.download-clicked();
                }
            }
        }

        VerticalLayout {
            padding: Theme.padding;
            spacing: 2px;

            Label {
                text: item.song-name;
                font-size: Theme.default-font-size - 2px;
                overflow: elide;
                color: Theme.primary-text-color;
            }

            Label {
                text: item.singers;
                font-size: Theme.default-font-size - 3px;
                overflow: elide;
                color: Theme.regular-text-color;
            }
        }
    }
}

component ThumbnailItem inherits Rectangle {
    in property <OnlineSearchImageResultItem> item;
    in property <length> size: Theme.icon-size * 4;

    callback preview-image();
    callback download-clicked();

    clip: true;
    width: size;
    height: size;
    background: Theme.secondary-background;
    border-radius: Theme.border-radius;

    if item.thumbnail.width > 0: Image {
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        source: item.thumbnail;

        TouchArea {
            enabled: !item.is-downloading;
            clicked => { root.preview-image(); }
        }
    }

    if item.thumbnail.width == 0: Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.secondary-background;

        Skeleton {
            width: parent.width;
            height: parent.height;
            type: SkeletonType.Picture;
        }
    }

    if item.is-downloading: Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.secondary-background;
        opacity: Theme.golden-ratio;

        Loading {
            width: parent.width;
            height: parent.height;
            icon-size: Theme.icon-size;
            loading-text: Logic.tr("Downloading");
        }
    }

    if !item.is-downloading: IconBtn {
        x: parent.width - self.width - Theme.padding;
        y: parent.height - self.height - Theme.padding;
        width: Theme.icon-size * 1.33;
        height: self.width;
        icon: Icons.download-light;
        border-radius: self.width / 2;
        show-icon-hover-background: false;
        gain-focus-when-clicked: false;
        colorize: self.has-hover ? Theme.light-text-color : Theme.invert-text-color;
        background: self.has-hover ? Theme.thirdly-brand-color : (item.is-downloaded ? Theme.success-color : Theme.thirdly-background);

        clicked => {
            root.download-clicked();
        }
    }
}

component ThumbnailGrid inherits Rectangle {
    in property <length> thumbnail-size: Theme.icon-size * 5;
    in property <[OnlineSearchImageResultItem]> results;
    private property <int> column-count: Math.max(1, (self.width - vbox.padding * 2 - grid-spacing) / (thumbnail-size + grid-spacing));
    private property <int> row-count: Math.ceil(results.length / column-count);
    private property <length> grid-spacing: Theme.spacing;

    callback download-clicked(index: int);

    ScrollView {
        width: parent.width;
        height: parent.height;

        vbox := VerticalLayout {
            padding: Theme.padding * 4;
            spacing: grid-spacing * 2;

            for row-index in row-count: HorizontalLayout {
                spacing: grid-spacing;
                alignment: row-count == 1 ? start : space-between;

                for col-index in column-count: ThumbnailItem {
                    property <int> idx: row-index * column-count + col-index;

                    size: thumbnail-size;
                    visible: row-index * column-count + col-index < results.length;
                    item: results[idx];

                    download-clicked => {
                        root.download-clicked(idx);
                    }

                    preview-image => {
                        Store.video-editor-item-preview-image = self.item.thumbnail;
                        Store.video-editor-preview-item = {
                            media-type : MediaType.Image,
                        };
                        Store.video-editor-is-show-item-preview-dialog = true;
                    }
                }
            }
        }
    }
}

component SourceEntry inherits Rectangle {
    in property <int> index;
    in-out property <OnlineSearchImageSourceEntry> source;

    callback enabled-changed(source: OnlineSearchImageSourceEntry);
    callback proxy-type-changed(value: OnlineSearchImageSourceEntry);

    height: hbox.preferred-height;
    background: mod(index, 2) == 0 ? Theme.table-item-first : Theme.table-item-second;

    hbox := HorizontalLayout {
        padding: Theme.padding * 2;
        padding-top: Theme.padding;
        padding-bottom: Theme.padding;
        spacing: Theme.spacing * 2;
        alignment: LayoutAlignment.space-between;

        VerticalLayout {
            alignment: center;

            CheckBtn {
                text: source.name;
                checked: source.enabled;

                toggled => {
                    source.enabled = !source.enabled;
                    root.enabled-changed(source);
                }
            }
        }

        HorizontalLayout {
            proxy-select := Select {
                width: Theme.default-font-size * 6;
                values: ["None", "Http", "Socks5"];
                current-value: source.proxy-type;
                gain-focus-when-clicked: false;
                is-show-indicator: false;
                background: root.background;
                indicator-left-padding: 0;

                selected(idx, value) => {
                    source.proxy-type = value;
                    root.proxy-type-changed(source);
                }
            }

            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: Theme.default-font-size;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: source.is-testing ? Theme.warning-color : (source.can-access ? Theme.success-color : Theme.danger-color);

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Logic.video-editor-online-search-image-refresh-source-status(index);
                        }
                    }
                }
            }
        }
    }
}

component ImageHeaderBar inherits Flickable {
    in property <length> select-width;

    height: header-hbox.preferred-height;
    viewport-width: header-hbox.preferred-width;

    header-hbox := HorizontalLayout {
        alignment: start;
        spacing: Theme.spacing * 4;

        IconBtn {
            icon: Icons.setting-light;
            icon-size: Theme.icon-size * 0.9;
            is-show-tip: true;
            tip: Logic.tr("Settings");

            clicked => {
                Store.video-editor-is-show-online-search-image-setting-dialog = true;
            }
        }

        HorizontalLayout {
            spacing: Theme.spacing * 4;

            HorizontalLayout {
                Label {
                    text: Logic.tr("Type") + ": ";
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;

                    Select {
                        vpadding: Theme.padding / 2;
                        width: root.select-width;
                        gain-focus-when-clicked: false;
                        indicator-left-padding: 0;
                        values: [
                            Logic.tr("all"),
                            Logic.tr("face"),
                            Logic.tr("photo"),
                            Logic.tr("clipart"),
                            Logic.tr("animated"),
                            Logic.tr("linedrawing")
                        ];
                        current-value: Store.video-editor-online-search-image-param.ty.is-empty ? Logic.tr("all") : Logic.tr(Store.video-editor-online-search-image-param.ty);

                        private property <string> value;

                        selected(index, value) => {
                            if index == 0 {
                                self.value = "all";
                            } else if index == 1 {
                                self.value = "face";
                            } else if index == 2 {
                                self.value = "photo";
                            } else if index == 3 {
                                self.value = "clipart";
                            } else if index == 4 {
                                self.value = "animated";
                            } else if index == 5 {
                                self.value = "linedrawing";
                            } else {
                                self.value = "all";
                            }
                            Store.video-editor-online-search-image-param.ty = value;
                        }
                    }
                }
            }

            HorizontalLayout {
                Label {
                    text: Logic.tr("Color") + ": ";
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    Select {
                        vpadding: Theme.padding / 2;
                        width: root.select-width;
                        gain-focus-when-clicked: false;
                        indicator-left-padding: 0;
                        values: [Logic.tr("all"), Logic.tr("color"), Logic.tr("backwhite")];
                        current-value: Store.video-editor-online-search-image-param.color.is-empty ? Logic.tr("all") : Store.video-editor-online-search-image-param.color;

                        private property <string> value;

                        selected(index, value) => {
                            if index == 0 {
                                self.value = "all";
                            } else if index == 1 {
                                self.value = "color";
                            } else if index == 2 {
                                self.value = "backwhite";
                            } else {
                                self.value = "all";
                            }
                            Store.video-editor-online-search-image-param.color = value;
                        }
                    }
                }
            }

            HorizontalLayout {
                Label {
                    text: Logic.tr("Size") + ": ";
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    Select {
                        vpadding: Theme.padding / 2;
                        width: root.select-width;
                        gain-focus-when-clicked: false;
                        indicator-left-padding: 0;
                        values: [Logic.tr("all"), Logic.tr("large"), Logic.tr("medium"), Logic.tr("small")];
                        current-value: Store.video-editor-online-search-image-param.size.is-empty ? Logic.tr("all") : Store.video-editor-online-search-image-param.size;

                        private property <string> value;
                        selected(index, value) => {
                            if index == 0 {
                                self.value = "all";
                            } else if index == 1 {
                                self.value = "large";
                            } else if index == 2 {
                                self.value = "medium";
                            } else if index == 3 {
                                self.value = "small";
                            } else {
                                self.value = "all";
                            }
                            Store.video-editor-online-search-image-param.size = value;
                        }
                    }
                }
            }
        }
    }
}

export component ImageGrid inherits Rectangle {
    border-color: Theme.base-border-color;
    border-width: Theme.default-border-width;

    VerticalLayout {
        padding: parent.padding;

        if Store.video-editor-online-search-image-is-searching: VerticalLayout {
            alignment: start;

            Skeleton {
                width: parent.width - Theme.padding * 4;
                height: Theme.icon-size * 8;
                type: SkeletonType.List;
            }
        }

        if !Store.video-editor-online-search-image-is-searching && Store.video-editor-online-search-image-results.length == 0: VerticalLayout {
            alignment: LayoutAlignment.center;

            HorizontalLayout {
                alignment: center;

                NoDataImg {
                    width: parent.width * 0.8;
                    text: Logic.tr("No Image");
                }
            }
        }

        if !Store.video-editor-online-search-image-is-searching && Store.video-editor-online-search-image-results.length > 0: ThumbnailGrid {
            results: Store.video-editor-online-search-image-results;

            download-clicked(index) => {
                Logic.video-editor-online-search-image-download(index);
            }
        }
    }
}


