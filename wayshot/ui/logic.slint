    pure public function audio-channels-to-int(channels: AudioChannels) -> int {
        if (channels == AudioChannels.Mono) {
            return 1;
        } else {
            return 2;
        }
    }

    pure public function audio-channels-from-int(channels: int) -> AudioChannels {
        if (channels == 1) {
            return AudioChannels.Mono;
        } else {
            return AudioChannels.Stereo;
        }
    }

    pure public function audio-sample-rate-to-int(rate: AudioSampleRate) -> int {
        if (rate == AudioSampleRate.Hz8000) {
            return 8000;
        } else if (rate == AudioSampleRate.Hz16000) {
            return 16000;
        } else if (rate == AudioSampleRate.Hz24000) {
            return 24000;
        } else if (rate == AudioSampleRate.Hz32000) {
            return 32000;
        } else if (rate == AudioSampleRate.Hz48000) {
            return 48000;
        } else if (rate == AudioSampleRate.Hz96000) {
            return 96000;
        } else if (rate == AudioSampleRate.Hz192000) {
            return 192000;
        } else {
            return 44100;
        }
    }

    pure public function audio-sample-rate-from-int(rate: int) -> AudioSampleRate {
        if (rate == 8000) {
            return AudioSampleRate.Hz8000;
        } else if (rate == 16000) {
            return AudioSampleRate.Hz16000;
        } else if (rate == 24000) {
            return AudioSampleRate.Hz24000;
        } else if (rate == 32000) {
            return AudioSampleRate.Hz32000;
        } else if (rate == 48000) {
            return AudioSampleRate.Hz48000;
        } else if (rate == 96000) {
            return AudioSampleRate.Hz96000;
        } else if (rate == 192000) {
            return AudioSampleRate.Hz192000;
        } else {
            return AudioSampleRate.Hz44100;
        }
    }

    pure public function resolution-to-string(res: Resolution) -> string {
        if (res == Resolution.Original) {
            return "Original";
        } else if (res == Resolution.P480) {
            return "480P";
        } else if (res == Resolution.P720) {
            return "720P";
        } else if (res == Resolution.P1080) {
            return "1080P";
        } else if (res == Resolution.P2K) {
            return "2K";
        } else if (res == Resolution.P4K) {
            return "4K";
        } else if (res == Resolution.Portrait480P) {
            return "Portrait 480P";
        } else if (res == Resolution.Portrait720P) {
            return "Portrait 720P";
        } else if (res == Resolution.Portrait1080P) {
            return "Portrait 1080P";
        } else if (res == Resolution.Portrait4K) {
            return "Portrait 4K";
        } else if (res == Resolution.Square480P) {
            return "Square 480P";
        } else if (res == Resolution.Square720P) {
            return "Square 720P";
        } else if (res == Resolution.Square1080P) {
            return "Square 1080P";
        } else if (res == Resolution.InstagramPortrait) {
            return "Instagram Portrait";
        } else {
            return "Original";
        }
    }

    pure public function resolution-from-string(res: string) -> Resolution {
        if (res == "Original") {
            return Resolution.Original;
        } else if (res == "480P") {
            return Resolution.P480;
        } else if (res == "720P") {
            return Resolution.P720;
        } else if (res == "1080P") {
            return Resolution.P1080;
        } else if (res == "2K") {
            return Resolution.P2K;
        } else if (res == "4K") {
            return Resolution.P4K;
        } else if (res == "Portrait 480P") {
            return Resolution.Portrait480P;
        } else if (res == "Portrait 720P") {
            return Resolution.Portrait720P;
        } else if (res == "Portrait 1080P") {
            return Resolution.Portrait1080P;
        } else if (res == "Portrait 4K") {
            return Resolution.Portrait4K;
        } else if (res == "Square 480P") {
            return Resolution.Square480P;
        } else if (res == "Square 720P") {
            return Resolution.Square720P;
        } else if (res == "Square 1080P") {
            return Resolution.Square1080P;
        } else if (res == "Instagram Portrait") {
            return Resolution.InstagramPortrait;
        } else {
            return Resolution.Original;
        }
    }

    pure public function resolution-from-width-height(width: int, height: int) -> string {
        // Landscape resolutions
        if (width == 3840 && height == 2160) {
            return "4K";
        } else if (width == 2560 && height == 1440) {
            return "2K";
        } else if (width == 1920 && height == 1080) {
            return "1080P";
        } else if (width == 1280 && height == 720) {
            return "720P";
        } else if (width == 854 && height == 480) {
            return "480P";
        // Portrait resolutions (9:16)
        } else if (width == 480 && height == 854) {
            return "Portrait 480P";
        } else if (width == 720 && height == 1280) {
            return "Portrait 720P";
        } else if (width == 1080 && height == 1920) {
            return "Portrait 1080P";
        } else if (width == 2160 && height == 3840) {
            return "Portrait 4K";
        // Square resolutions (1:1)
        } else if (width == 480 && height == 480) {
            return "Square 480P";
        } else if (width == 720 && height == 720) {
            return "Square 720P";
        } else if (width == 1080 && height == 1080) {
            return "Square 1080P";
        // Instagram Portrait (4:5)
        } else if (width == 1080 && height == 1350) {
            return "Instagram Portrait";
        } else {
            return "1080P";
        }
    }

    pure public function resolution-to-width-height(res: string) -> [int] {
        // Landscape resolutions
        if (res == "4K") {
            return [3840, 2160];
        } else if (res == "2K") {
            return [2560, 1440];
        } else if (res == "1080P") {
            return [1920, 1080];
        } else if (res == "720P") {
            return [1280, 720];
        } else if (res == "480P") {
            return [854, 480];
        // Portrait resolutions (9:16)
        } else if (res == "Portrait 480P") {
            return [480, 854];
        } else if (res == "Portrait 720P") {
            return [720, 1280];
        } else if (res == "Portrait 1080P") {
            return [1080, 1920];
        } else if (res == "Portrait 4K") {
            return [2160, 3840];
        // Square resolutions (1:1)
        } else if (res == "Square 480P") {
            return [480, 480];
        } else if (res == "Square 720P") {
            return [720, 720];
        } else if (res == "Square 1080P") {
            return [1080, 1080];
        // Instagram Portrait (4:5)
        } else if (res == "Instagram Portrait") {
            return [1080, 1350];
        } else {
            return [1920, 1080]; // default to 1080P
        }
    }

    pure public function image-effect-to-string(effect: RealtimeImageEffect) -> string {
        if (effect == RealtimeImageEffect.Grayscale) {
            return Logic.tr("Grayscale");
        } else if (effect == RealtimeImageEffect.Invert) {
            return Logic.tr("Invert");
        } else if (effect == RealtimeImageEffect.SnowNoise) {
            return Logic.tr("SnowNoise");
        } else if (effect == RealtimeImageEffect.SnowNoiseTV) {
            return Logic.tr("SnowNoiseTV");
        } else if (effect == RealtimeImageEffect.Rosetint) {
            return Logic.tr("Rosetint");
        } else if (effect == RealtimeImageEffect.Twenties) {
            return Logic.tr("Twenties");
        } else if (effect == RealtimeImageEffect.Mauve) {
            return Logic.tr("Mauve");
        } else if (effect == RealtimeImageEffect.Radio) {
            return Logic.tr("Radio");
        } else if (effect == RealtimeImageEffect.Bluechrome) {
            return Logic.tr("Bluechrome");
        } else if (effect == RealtimeImageEffect.Dramatic) {
            return Logic.tr("Dramatic");
        } else if (effect == RealtimeImageEffect.PastelPink) {
            return Logic.tr("Pastel Pink");
        } else if (effect == RealtimeImageEffect.Obsidian) {
            return Logic.tr("Obsidian");
        } else if (effect == RealtimeImageEffect.Pixelate) {
            return Logic.tr("Pixelate");
        } else if (effect == RealtimeImageEffect.Posterize) {
            return Logic.tr("Posterize");
        } else if (effect == RealtimeImageEffect.Sepia) {
            return Logic.tr("Sepia");
        } else if (effect == RealtimeImageEffect.Vignette) {
            return Logic.tr("Vignette");
        } else if (effect == RealtimeImageEffect.Temperature) {
            return Logic.tr("Temperature");
        } else {
            return Logic.tr("None");
        }
    }

    pure public function downloader-progress-color(state: DownloaderState) -> color {
        if (state == DownloaderState.Cancelled) {
            return Theme.warning-color;
        } else if (state == DownloaderState.Failed) {
            return Theme.danger-color;
        } else {
            return Theme.thirdly-brand-color;
        }
    }

    pure public function defalut-video-editor-track-name(ty: VideoEditorTrackType, index: int) -> string {
        if (ty == VideoEditorTrackType.Video) {
            return "V" + index;
        } else if (ty == VideoEditorTrackType.Audio) {
            return "A" + index;
        } else if (ty == VideoEditorTrackType.Subtitle) {
            return "S" + index;
        } else if (ty == VideoEditorTrackType.Image) {
            return "I" + index;
        } else if (ty == VideoEditorTrackType.Text) {
            return "T" + index;
        } else {
            return index;
        }
    }

    pure public function startup-tab-to-str(tab: StartupTab) -> string {
        if (tab == StartupTab.VideoEditor) {
            return "VideoEditor";
        } else if (tab == StartupTab.Transcribe) {
            return "Transcribe";
        } else if (tab == StartupTab.ShareScreen) {
            return "ShareScreen";
        } else {
            return "Recorder";
        }
    }

    pure public function startup-tab-from-str(tab: string) -> StartupTab {
        if (tab == "VideoEditor") {
            return StartupTab.VideoEditor;
        } else if (tab == "Transcribe") {
            return StartupTab.Transcribe;
        } else if (tab == "ShareScreen") {
            return StartupTab.ShareScreen;
        } else {
            return StartupTab.Recorder;
        }
    }

    pure public function video-editor-track-segment-color(ty: VideoEditorTrackType, disabled: bool) -> color {
        if (!disabled) {
            if (ty == VideoEditorTrackType.Video) {
                return Theme.thirdly-brand-color;
            } else if (ty == VideoEditorTrackType.Audio) {
                return Theme.is-dark ? #2a9d8f : #9fd9c4;
            } else if (ty == VideoEditorTrackType.Subtitle) {
                return Theme.is-dark ? #b48010 : #b5832b;
            } else if (ty == VideoEditorTrackType.Image) {
                return Theme.is-dark ? #6b4e71 : #c8a2d4;
            } else if (ty == VideoEditorTrackType.Text) {
                return Theme.is-dark ? #8b7355.darker(30%) : #8b7355.brighter(30%);
            } else {
                return Theme.is-dark ? #6b4e71 : #c8a2d4;
            }
        } else {
            Theme.disabled-color;
        }
    }

    pure public function video-editor-track-height(ty: VideoEditorTrackType) -> length {
        let compat-mode = Store.video-editor-preference-config.track.compact-mode;

        if (ty == VideoEditorTrackType.Video) {
            if compat-mode {
                return Theme.icon-size * 1 + Theme.padding * 4;
            } else {
                return Theme.icon-size * 2 + Theme.padding * 4;
            }
        } else if (ty == VideoEditorTrackType.Subtitle || ty == VideoEditorTrackType.Text) {
            if compat-mode {
                return Theme.icon-size * 0.6 + Theme.padding * 4;
            } else {
                return Theme.icon-size + Theme.padding * 4;
            }
        } else {
            if compat-mode {
                return Theme.icon-size * 0.8 + Theme.padding * 4;
            } else {
                return Theme.icon-size * 1.5 + Theme.padding * 4;
            }
        }
    }

