        return "00:00:00,000";
    }

    video-editor-preview-size() => {
        return { width: 1920, height: 1080 };
    }

    video-editor-get-track-height-pixels(ty) => {
        return round(Logic.video-editor-track-height(ty) / 1px);
    }

    video-editor-selected-segment => {
        return Store.video-editor-tracks-manager.tracks[0].segments[0];
    }

    pure public function fps-to-int(fps: Fps) -> int {
        if (fps == Fps.Fps24) {
            return 24;
        } else if (fps == Fps.Fps25) {
            return 25;
        } else if (fps == Fps.Fps30) {
            return 30;
        } else if (fps == Fps.Fps60) {
            return 60;
        } else {
            return 25;
        }
    }

    pure public function fps-from-int(fps: int) -> Fps {
        if (fps == 24) {
            return Fps.Fps24;
        } else if (fps == 25) {
            return Fps.Fps25;
        } else if (fps == 30) {
            return Fps.Fps30;
        } else if (fps == 60) {
            return Fps.Fps60;
        } else {
            return Fps.Fps25;
        }
    }

    pure public function audio-format-to-str(format: AudioFormat) -> string {
        if (format == AudioFormat.Aac) {
            return "Aac";
        } else if (format == AudioFormat.Ogg) {
            return "Ogg";
        } else if (format == AudioFormat.Wav) {
            return "Wav";
        } else if (format == AudioFormat.Flac) {
            return "Flac";
        } else {
            return "Mp3";
        }
    }

    pure public function audio-format-from-str(format: string) -> AudioFormat {
        if (format.to-lowercase() == "aac") {
            return AudioFormat.Aac;
        } else if (format.to-lowercase() == "ogg") {
            return AudioFormat.Ogg;
        } else if (format.to-lowercase() == "wav") {
            return AudioFormat.Wav;
        } else if (format.to-lowercase() == "flac") {
            return AudioFormat.Flac;
        } else {
            return AudioFormat.Mp3;
        }
    }

